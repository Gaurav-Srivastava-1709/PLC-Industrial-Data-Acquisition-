<Application x:Class="WTT.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WTT.UI.Converters"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters available everywhere -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
            <conv:QualityToBrushConverter x:Key="QualityToBrush" />
            <conv:BoolToBrushConverter x:Key="BoolToBrush" />
            <conv:DeviceStatusToBrushConverter x:Key="DeviceStatusToBrush" />
            <conv:EnumDescriptionConverter x:Key="EnumDesc" />
            <conv:UtcToLocalConverter x:Key="UtcToLocal" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
