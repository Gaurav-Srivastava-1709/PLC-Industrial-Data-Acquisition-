<ui:FluentWindow x:Class="WTT.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:WTT.UI.Views.Pages"
        Title="WTT Systems — 2026 DAQ Platform" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent TitleBar with Minimize, Maximize, Close buttons -->
        <ui:TitleBar Grid.Row="0" Title="WTT Systems — 2026 DAQ Platform" />

        <!-- Navigation View (Left Sidebar + Content) -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="220">

            <!-- Navigation Menu Items (Left Sidebar) -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" Icon="Home24" TargetPageType="{x:Type pages:DashboardPage}"/>
                
                <!-- Devices: Admin & Operator can view -->
                <ui:NavigationViewItem Content="Devices" Icon="Router24" TargetPageType="{x:Type pages:DevicesPage}"
                                       Visibility="{Binding IsOperatorOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <!-- Tags & Live Data: Everyone can view -->
                <ui:NavigationViewItem Content="Tags" Icon="Tag24" TargetPageType="{x:Type pages:TagsPage}"/>
                <ui:NavigationViewItem Content="Live Data" Icon="PulseSquare24" TargetPageType="{x:Type pages:LiveDataPage}"/>
                
                <!-- Data Transfer: Admin & Operator can view -->
                <ui:NavigationViewItem Content="Transfer" Icon="ArrowSync24" TargetPageType="{x:Type pages:DataTransferPage}"
                                       Visibility="{Binding IsOperatorOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <!-- Users: Admin Only -->
                <ui:NavigationViewItem Content="Users" Icon="People24" TargetPageType="{x:Type pages:UsersPage}"
                                       Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <ui:NavigationViewItem Content="Logs" Icon="DocumentText24" IsEnabled="False"/>
            </ui:NavigationView.MenuItems>

            <!-- Footer Items (Bottom of Sidebar) -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" Icon="Settings24" TargetPageType="{x:Type pages:SettingsPage}"/>
            </ui:NavigationView.FooterMenuItems>

            <!-- Header (User Info + Logout) -->
            <ui:NavigationView.Header>
                <Border Padding="16,8,16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Logged in as: "/>
                                <Run Text="{Binding CurrentUsername}" FontWeight="SemiBold"
                                     Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding CurrentUserRole}" Foreground="#3498DB"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Logout" Icon="SignOut24" Appearance="Secondary"
                                   Command="{Binding LogoutCommand}"/>
                    </Grid>
                </Border>
            </ui:NavigationView.Header>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
