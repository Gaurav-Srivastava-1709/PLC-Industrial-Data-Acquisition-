<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Page layout -->
    <Style x:Key="PageRoot" TargetType="Grid">
        <Setter Property="Margin" Value="24,16,24,24" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Card container -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- DataGrid defaults.
         Virtualization ON is load-bearing: without it every row is measured on each
         refresh, which freezes scrolling on the Batches (50 rows/5s) and Logs pages. -->
    <Style x:Key="Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AlternationCount" Value="2" />
        <!-- Alternate row cream + dark text DONO set hai taaki dark mode me bhi
             padha jaye (dark theme ka safed text cream par gayab ho jata tha).
             Selection (green) template-level par isse upar rehta hai. -->
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#FFF8E1" />
                            <Setter Property="Foreground" Value="#1A1A1A" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <!-- Table row height ko 38px set kiya taaki cell action buttons (Edit/Delete) neeche se cut na hon -->
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.CacheLength" Value="5,5" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
    </Style>

    <!-- Status dot -->
    <Style x:Key="Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <SolidColorBrush x:Key="GoodBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F39C12" />
    <SolidColorBrush x:Key="BadBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#9CA3AF" />

    <!-- ======================================================================
         DASHBOARD TOKENS - high-performance HMI, ISA-101.01 aligned
         ======================================================================
         The previous revision of this page was a consumer-SaaS "stat card"
         look. That is the wrong idiom for a plant-floor operator console and
         this block replaces it. The rules driving every value below, with the
         measured WPF-UI 4.3.0 theme colours noted so future edits stay honest:

         ISA-101 colour discipline
           * Normal operation is drawn in muted grey/white. Colour is RESERVED
             for abnormal conditions and machine state - never decoration.
             "Saturation reduces sensitivity: if everything is coloured, nothing
             stands out, and abnormal conditions get harder to detect, not
             easier." Six differently tinted KPI cards destroyed exactly that.
           * Green is NOT used for "normal". A green card because green looks
             nice trains the operator to ignore green when it means something.

         Measured theme tokens used here (light / dark):
           SolidBackgroundFillColorSecondaryBrush   #EEEEEE / #1C1C1C
           LayerFillColorAltBrush                  #FFFFFF / #FFFFFF a=.05
           CardStrokeColorDefaultBrush             #000 a=.06 / #000 a=.10
           TextFillColorPrimaryBrush               #000 a=.89 / #FFFFFF
           SystemFillColorSuccessBrush             #0F7B0F / #6CCB5F
           SystemFillColorCautionBrush             #9D5D00 / #FCE100
           SystemFillColorCriticalBrush            #C42B1C / #FF99A4
           SystemFillColorNeutralBrush             #000 a=.45 / #FFF a=.55
           SystemAccentColorPrimaryBrush           #0067C0 / #0067C0  (see warning)

         WARNING: the single biggest cause of the old "muddy in dark mode" look is
         that SystemAccentColorPrimaryBrush is #0067C0 in BOTH themes. It is a fixed
         brand blue built for light mode and is nearly invisible on a dark surface.
         So accent brushes are used ONLY as button fills (white text on blue) and as
         hover outlines, NEVER as the colour of a number or label. Every number and
         label below uses TextFillColor* (genuinely theme-adaptive) or a
         SystemFillColor* semantic brush (also adaptive: success / caution / critical
         differ per theme).

         Typography: ISA-101 requires >= 14 px for primary readouts, and a
         consistent type scale. Numbers stay left-aligned so a column of them
         can be scanned vertically without the ragged centred look.

         Motion: ISA-101 says animation is only justified when it communicates
         something, and that decorative motion costs real detection time. The
         hover states below are therefore a 140 ms surface + border transition,
         with no scale, bounce or glow.
         ====================================================================== -->

    <!-- Page canvas. Soft neutral grey in light, soft near-black in dark.
         Deliberately not ApplicationBackgroundBrush (#FAFAFA / #202020): near
         white on light is the "hurts my eyes" flat look, and near black is
         equally harsh. This token is the softest true-neutral both themes
         offer, and the white cards on top of it give real separation. -->
    <Style x:Key="DashCanvas" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
    </Style>

    <!-- Card surface: opaque white in light, a lifted #262626-ish panel in dark. -->
    <Style x:Key="DashCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Section caption, e.g. "DEVICES". Muted, small, bold. -->
    <Style x:Key="DashSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DashPanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DashPanelSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- KPI card. Neutral surface, no tint: colour is spent only on the two
         metrics that can actually be abnormal (buffer, errors). Hover is a
         quiet surface + outline change. -->
    <Style x:Key="DashKpiCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <!-- Hover is a quiet outline + surface change. No scale, no glow:
                 ISA-101 holds that decorative motion on read-only displays
                 costs operators real detection time. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- KPI label: small, bold, muted, uppercase-style. The value below it
         carries the meaning. -->
    <Style x:Key="DashKpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Primary readout. 26 px, comfortably above the ISA-101 14 px floor, and
         always TextFillColorPrimaryBrush so it is readable in both themes. -->
    <Style x:Key="DashKpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="DashKpiUnit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="DashDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Opacity" Value="0.18" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="DashChartGridLine" TargetType="Line">
        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="StrokeThickness" Value="0.6" />
        <Setter Property="Opacity" Value="0.2" />
        <Setter Property="StrokeDashArray" Value="2,3" />
    </Style>

    <Style x:Key="DashPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DashPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DashMiniLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="DashMiniValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DashRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DashRowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Device tile. Same calm treatment; hover is an outline change only. -->
    <Style x:Key="DashTileCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================================================
         DIALOG WIDTH - app-wide, fixes the "giant button" confirm dialogs
         ======================================================================
         Measured on a 1200 px window, WPF-UI 4.3.0:
           ContentDialog.ActualWidth  = 1187   (i.e. it filled the whole window)
           "Enable simulator" button  = 440 wide, HorizontalAlignment = Stretch
           "Cancel" button            = 440 wide, HorizontalAlignment = Stretch
         ContentDialog ships no effective MaxWidth (its DialogMaxWidth default is
         the sentinel 8), so a long message stretched the dialog to the window
         and the two stretch-aligned footer buttons each took half of it. That
         is why the confirm buttons looked absurdly oversized.

         This caps the dialog at 520 px, which brings the footer buttons down to
         roughly 200 px each - normal for a text button.

         MaxWidth/MinWidth are used deliberately rather than DialogMaxWidth:
         the template does not bind DialogMaxWidth to the root's MaxWidth, so
         setting it would have had no effect. MaxWidth is a plain
         FrameworkElement property and always clamps.

         BasedOn the WPF-UI implicit style (verified to exist) so all of the
         control's own theming, animation and template are preserved - this only
         overrides sizing.
         ====================================================================== -->
    <Style TargetType="{x:Type ui:ContentDialog}"
           BasedOn="{StaticResource {x:Type ui:ContentDialog}}">
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="MinWidth" Value="400" />
    </Style>

    <!-- ======================================================================
         SIDEBAR NAVIGATION - professional industrial look (light + dark)
         ======================================================================
         Design language (researched: ISA-101 high-performance HMI + modern
         SCADA consoles like Ignition Perspective / Siemens WinCC Unified):
           * Sidebar surface stays theme-adaptive (WPF-UI system brushes), so
             light mode is soft slate-grey, dark mode is deep slate - never
             pure white / pure black which hurts eyes on the plant floor.
           * ONE accent only: industrial sky #0EA5E9. Colour is reserved for
             the selected indicator + subtle tint, per ISA-101 discipline
             ("if everything is coloured, nothing stands out").
           * Selected = translucent accent wash + 3px accent indicator bar
             (via NavigationViewSelectionIndicatorForeground override in
             MainWindow) + semibold text. Hover = lighter wash.
           * Translucent washes (#2E / #14 alpha) work on BOTH themes because
             they blend over whatever the adaptive sidebar surface is.
           * Typography: Segoe UI Variable Text, 13.5px items, 11px section
             captions - consistent type scale, left aligned for fast scanning.
         ====================================================================== -->

    <SolidColorBrush x:Key="WttAccentBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="WttAccentDeepBrush" Color="#0284C7" />
    <!-- Selected item wash: sky at ~18% alpha. Tints light-grey AND dark. -->
    <SolidColorBrush x:Key="WttNavSelectedBackgroundBrush" Color="#2E0EA5E9" />
    <!-- Selected + hover: sky at ~25% alpha. -->
    <SolidColorBrush x:Key="WttNavSelectedHoverBackgroundBrush" Color="#400EA5E9" />
    <!-- Hover wash: sky at ~8% alpha. Quiet, no glow (ISA-101: no decor motion). -->
    <SolidColorBrush x:Key="WttNavHoverBackgroundBrush" Color="#140EA5E9" />
    <!-- Alarm count badge: saturated red is reserved for abnormal only. -->
    <SolidColorBrush x:Key="WttAlarmBadgeBrush" Color="#EF4444" />
    <FontFamily x:Key="WttNavFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Regular menu item. BasedOn preserves the WPF-UI template (verified
         pattern - same as the ContentDialog style above); only property
         values + triggers are added, so selected/hover always render. -->
    <Style x:Key="WttNavItemStyle" TargetType="{x:Type ui:NavigationViewItem}"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
        <Setter Property="FontFamily" Value="{StaticResource WttNavFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="6,2,6,2" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WttNavHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
                <Setter Property="Background" Value="{StaticResource WttNavSelectedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsActive" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource WttNavSelectedHoverBackgroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Non-clickable section caption (MONITOR / MANAGE). Hit-test invisible
         so it never hovers, focuses or navigates - pure label. -->
    <Style x:Key="WttNavSectionStyle" TargetType="{x:Type ui:NavigationViewItem}"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
        <Setter Property="FontFamily" Value="{StaticResource WttNavFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="16,10,0,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Brand block at the top of the pane. Non-clickable identity header. -->
    <Style x:Key="WttNavBrandStyle" TargetType="{x:Type ui:NavigationViewItem}"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="6,8,6,4" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- All table headers app-wide: blue (#1D4ED8) background, white text.
         Sirf rang hai - koi template change nahi, isliye header ka
         design, separator aur sort arrow bilkul pehle jaisa rahega. -->
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#1D4ED8" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Selected table row app-wide: blue ki jagah light green (Excel jaisa).
         Sirf selection ke rang hai - koi template change nahi. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C6EFCE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#006100" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2EFDA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#006100" />

    <!-- Table row ke action buttons (Write/Configure/Edit/Verify...): cream
         alternate row par dark mode ka safed text gayab ho jata tha.
         Danger (red) buttons ka apna background hai, unhe ye nahi chahiye. -->
    <Style x:Key="RowActionBtn" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                <Setter Property="Foreground" Value="#1A1A1A" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shared colourful KPI cards (Tailwind-admin inspired, Dashboard jaisa):
         FIXED pastel gradients + dark text, isliye Light aur Dark dono me
         same dikhte hai. DashboardPage me inhi ki local copy hai. -->
    <LinearGradientBrush x:Key="KpiBlueBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DBEAFE" Offset="0" />
        <GradientStop Color="#BFDBFE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiTealBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCFBF1" Offset="0" />
        <GradientStop Color="#99F6E0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiPurpleBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EDE9FE" Offset="0" />
        <GradientStop Color="#DDD6FE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiAmberBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FEF3C7" Offset="0" />
        <GradientStop Color="#FDE68A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiPinkBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCE7F3" Offset="0" />
        <GradientStop Color="#FBCFE8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiRedBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FEE2E2" Offset="0" />
        <GradientStop Color="#FECACA" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style x:Key="ModernKpiCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="Padding" Value="14,14,14,0" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#CCFFFFFF" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-3" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#40000000" BlurRadius="14"
                                          ShadowDepth="3" Direction="270" Opacity="0.45" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Coral Refresh buttons (flat, rounded, white icon + text).
         Native Button + apna template taaki hover par rang na badle
         (WPF-UI Button hover override karta hai - Delete wala sabak).
         Text wale = CoralRefreshBtn, icon-only = CoralRefreshIconBtn. -->
    <Style x:Key="CoralRefreshBtn" TargetType="{x:Type Button}">
