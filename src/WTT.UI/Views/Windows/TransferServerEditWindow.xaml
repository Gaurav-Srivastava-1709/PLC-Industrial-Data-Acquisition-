<ui:FluentWindow x:Class="WTT.UI.Views.Windows.TransferServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="560" Width="560" MinWidth="500"
        Icon="pack://application:,,,/Resources/WTTLogo.png"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="SQL Server *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="SERVER\INSTANCE or host,port" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Database *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Table" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="Windows authentication (integrated security)" IsChecked="{Binding UseIntegratedSecurity}" Margin="0,8,0,0" />
                <Grid Visibility="{Binding UseIntegratedSecurity, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="User id" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <ui:PasswordBox x:Name="PwdBox" PasswordChanged="Pwd_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Text="Leave empty to keep the stored password." Visibility="{Binding HasStoredPassword, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Encrypt connection" IsChecked="{Binding Encrypt}" Margin="0,0,16,0" />
                    <CheckBox Content="Trust server certificate" IsChecked="{Binding TrustServerCertificate}" Margin="0,0,16,0" />
                    <CheckBox Content="Transfer enabled" IsChecked="{Binding IsEnabled}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                           Text="The table is created automatically if missing (legacy-compatible TagDetail layout: TagName, PLCName, TagValue, TimeStamp, TimeStampUTC) and extended with Quality, ScanId and a source key that makes transfers idempotent. The password is stored encrypted with Windows DPAPI." />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource ConfigureBtn}" Command="{Binding TestCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PlugConnected24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Test connection" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                <Style.Triggers><DataTrigger Binding="{Binding TestSucceeded}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource NeutralBtn}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource ExportBtn}" Command="{Binding SaveCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
