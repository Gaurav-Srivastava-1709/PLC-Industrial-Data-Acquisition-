<ui:FluentWindow x:Class="WTT.UI.Views.Windows.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="720" Width="620" MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel>
                <TextBlock Text="Identification" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Device name *" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Boiler-1" />
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Controller" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding Manufacturer}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding AddressHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="IP address / host *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.168.1.10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Port}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Poll (ms)" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding PollIntervalMs}" Minimum="100" Maximum="3600000" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Timeout (ms)" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding TimeoutMs}" Minimum="200" Maximum="60000" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0" Visibility="{Binding ShowSlot, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Slot" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Slot}" Minimum="0" Maximum="31" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0" Visibility="{Binding ShowRack, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Rack" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Rack}" Minimum="0" Maximum="7" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0" Visibility="{Binding ShowConnectionSize, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Connection size" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ConnectionSizes}" SelectedItem="{Binding ConnectionSize}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Visibility="{Binding ShowCipPath, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CIP path (optional)" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding CipPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="1,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0" Visibility="{Binding ShowUnitId, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Unit / slave id" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding UnitId}" Minimum="0" Maximum="255" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0" Visibility="{Binding ShowWordOrder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Word order (32-bit)" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding WordOrders}" SelectedItem="{Binding WordOrder}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Visibility="{Binding ShowUnitId, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="Addresses are 1-based (40001 style)" IsChecked="{Binding OneBasedAddressing}" Margin="0,0,0,4" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Device enabled" IsChecked="{Binding IsEnabled}" Margin="0,16,0,0" />

                <!-- Auto Tag Provisioning — sirf new device pe dikhega -->
                <Border Margin="0,16,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding ShowAutoSeed, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <CheckBox Content="🚀 Auto-provision default tags" IsChecked="{Binding AutoSeedTags}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AutoSeedHint}" Style="{StaticResource Hint}" Margin="28,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="Test connection" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestConnectionCommand}" />
                    <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
