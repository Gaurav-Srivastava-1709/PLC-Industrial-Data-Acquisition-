<ui:FluentWindow x:Class="WTT.UI.Views.Windows.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Device Configuration" Height="530" Width="420"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Configure PLC Device" />

        <ScrollViewer Grid.Row="1" Padding="24,12,24,12">
            <StackPanel>
                <TextBlock Text="Device Name" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Device.Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Boiler PLC 01" Margin="0,0,0,12"/>

                <TextBlock Text="IP Address" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Device.IpAddress, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 192.168.1.50" Margin="0,0,0,12"/>

                <TextBlock Text="Port" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Device.Port, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 502" Margin="0,0,0,12"/>

                <TextBlock Text="Protocol" FontWeight="Medium" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding Device.Protocol, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,0,12">
                    <ComboBoxItem Content="ModbusTCP"/>
                    <ComboBoxItem Content="EthernetIP"/>
                    <ComboBoxItem Content="SiemensS7"/>
                </ComboBox>

                <TextBlock Text="Description (Optional)" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Device.Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Main Plant Boiler Controller" Margin="0,0,0,12"/>

                <CheckBox Content="Is Enabled (Active for polling)" IsChecked="{Binding Device.IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12,24,16" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <ui:Button Content="Save Device" Appearance="Primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
