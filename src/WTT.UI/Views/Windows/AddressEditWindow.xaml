<ui:FluentWindow x:Class="WTT.UI.Views.Windows.AddressEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="560" Width="560" MinWidth="500"
        Icon="pack://application:,,,/Resources/WTTLogo.png"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Block type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AddressTypes}" SelectedItem="{Binding AddressType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Register type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding RegisterType}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Start address" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding StartAddress}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Data type per point" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Number of points" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox Value="{Binding PointCount}" Minimum="1" Maximum="2000" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tag prefix *" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding TagPrefix, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="CH" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Module offset" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox Value="{Binding ModuleOffset}" Minimum="-65535" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Decimals (rounding)" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PlaceholderText="none" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox Content="Index starts at 0 (ADAM)" IsChecked="{Binding ZeroBasedTagIndex}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="12,8" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    </Border>
                </StackPanel>

                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Yokogawa MW100: Input registers, Float32, prefix CH, 2 decimals. GM10: channels are laid out in banks of 10 (handled automatically). ADAM-6017/6018: Holding registers, UInt16, 0-based. Walchem W600: use a Discrete block and define tags by hand." />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource NeutralBtn}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource ExportBtn}" Command="{Binding SaveCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save &amp; generate tags" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
