<ui:FluentWindow x:Class="WTT.UI.Views.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="460" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="28,8,28,24">
            <TextBlock Text="{Binding Explanation}" Style="{StaticResource PageSubtitle}" />

            <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox x:Name="CurrentBox" PasswordChanged="Current_Changed" />

            <TextBlock Text="New password" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox x:Name="NewBox" PasswordChanged="New_Changed" />

            <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox x:Name="ConfirmBox" PasswordChanged="Confirm_Changed" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Save password" Appearance="Primary" Command="{Binding SubmitCommand}" IsDefault="True"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
