<ui:FluentWindow x:Class="WTT.UI.Views.Windows.WriteTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="360" Width="440" ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/WTTLogo.png"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitle}" />
            <TextBlock Text="New value" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="ValueBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            <Border Background="#3A2A00" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding AwaitingConfirm, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ConfirmMessage}" TextWrapping="Wrap" Foreground="#FFD97A" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource NeutralBtn}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource DangerBtn}" Command="{Binding WriteCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Send24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WriteButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
