<Window x:Class="WTT.UI.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:WTT.UI.Views.Pages"
        Title="WTT — Industrial Data Acquisition" Height="800" Width="1280" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding OpenDashboardCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LogoutCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" OpenPaneLength="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="Devices" Icon="{ui:SymbolIcon Router24}" TargetPageType="{x:Type pages:DevicesPage}"
                                       Visibility="{Binding CanViewDevices, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Live Data" Icon="{ui:SymbolIcon PulseSquare24}" TargetPageType="{x:Type pages:LiveDataPage}"
                                       Visibility="{Binding CanViewLiveData, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Trends" Icon="{ui:SymbolIcon DataHistogram24}" TargetPageType="{x:Type pages:TrendsPage}"
                                       Visibility="{Binding CanViewLiveData, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Data Transfer" Icon="{ui:SymbolIcon ArrowSync24}" TargetPageType="{x:Type pages:DataTransferPage}"
                                       Visibility="{Binding CanViewTransfer, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Users" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type pages:UsersPage}"
                                       Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Logs" Icon="{ui:SymbolIcon DocumentText24}" TargetPageType="{x:Type pages:LogViewerPage}"
                                       Visibility="{Binding CanViewLogs, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Alarms" Icon="{ui:SymbolIcon Alert24}" TargetPageType="{x:Type pages:AlarmsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <!-- Visible to all roles: account actions live in Settings (My Account) and My Profile. -->
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.Header>
                <Border Padding="24,8,24,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Alarm Bell with Badge + Beep Toggle In-Out -->
                            <ui:Button ToolTip="Active Alarms" Appearance="Secondary" Margin="0,0,6,0" Command="{Binding OpenAlarmsCommand}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Alert24" />
                                    <Border CornerRadius="8" Background="#E53935" MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" Visibility="{Binding HasActiveAlarms, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ActiveAlarmCount}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </ui:Button>
                            <CheckBox IsChecked="{Binding IsBeepEnabled}" Content="Beep" ToolTip="Beep Silent/ON (Critical/High only)" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <!-- Compact account entry: full profile opens on its own page. -->
                            <ui:Button ToolTip="My Profile" Appearance="Secondary"
                                       Command="{Binding OpenProfileCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Account" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="1" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="600" />
    </Grid>
</Window>
