<Window x:Class="WTT.UI.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:WTT.UI.Views.Pages"
        Title="" Height="800" Width="1280" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#1E293B">
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding OpenDashboardCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LogoutCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False" OpenPaneLength="248"
                           FontFamily="{StaticResource WttNavFontFamily}" FontSize="13.5">
            <!-- NOTE: Pane ka apna koi background brush nahi hai (WPF-UI template
                 PaneBorder ko transparent rakhta hai), isliye Window ka #1E293B
                 background hi sidebar me dikhta hai. Content area par iska asar
                 nahi (uski apni NavigationViewContentBackground hai).
                 Hamburger toggle hata diya: uska icon theme-foreground se aata
                 hai jo dark sidebar par invisible ho jata. -->
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#00000000" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#4F46E5" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#6366F1" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#14FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#294F46E5" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#CBD5E1" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="#1E293B" />
            </ui:NavigationView.Resources>
            <ui:NavigationView.MenuItems>
                <!-- Brand identity: gradient tile + product name. Non-clickable. -->
                <ui:NavigationViewItem Style="{StaticResource WttNavBrandStyle}" IsHitTestVisible="False" Focusable="False">
                    <ui:NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="11">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0EA5E9" Offset="0" />
                                        <GradientStop Color="#0369A1" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#400EA5E9" BlurRadius="12" ShadowDepth="0" Opacity="0.7" />
                                </Border.Effect>
                                <ui:SymbolIcon Symbol="Pulse24" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="WTT" FontSize="17" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="INDUSTRIAL DATA ACQUISITION" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </ui:NavigationViewItem.Content>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Style="{StaticResource WttNavSectionStyle}" Content="MONITOR" IsHitTestVisible="False" Focusable="False" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Dashboard" Icon="{ui:SymbolIcon Grid24}" TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Live Data" Icon="{ui:SymbolIcon Pulse24}" TargetPageType="{x:Type pages:LiveDataPage}"
                                       Visibility="{Binding CanViewLiveData, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Trends" Icon="{ui:SymbolIcon ChartMultiple24}" TargetPageType="{x:Type pages:TrendsPage}"
                                       Visibility="{Binding CanViewLiveData, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Icon="{ui:SymbolIcon AlertUrgent24}" TargetPageType="{x:Type pages:AlarmsPage}">
                    <ui:NavigationViewItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Alarms" VerticalAlignment="Center" />
                            <Border Grid.Column="1" MinWidth="22" Height="18" CornerRadius="9" Padding="6,0"
                                    Background="{StaticResource WttAlarmBadgeBrush}" Margin="8,0,4,0"
                                    Visibility="{Binding HasActiveAlarms, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveAlarmCount}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ui:NavigationViewItem.Content>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Style="{StaticResource WttNavSectionStyle}" Content="MANAGE" IsHitTestVisible="False" Focusable="False" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Devices" Icon="{ui:SymbolIcon Server24}" TargetPageType="{x:Type pages:DevicesPage}"
                                       Visibility="{Binding CanViewDevices, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Data Transfer" Icon="{ui:SymbolIcon ArrowSync24}" TargetPageType="{x:Type pages:DataTransferPage}"
                                       Visibility="{Binding CanViewTransfer, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Users" Icon="{ui:SymbolIcon PeopleTeam24}" TargetPageType="{x:Type pages:UsersPage}"
                                       Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Logs" Icon="{ui:SymbolIcon DocumentText24}" TargetPageType="{x:Type pages:LogViewerPage}"
                                       Visibility="{Binding CanViewLogs, Converter={StaticResource BoolToVis}}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <!-- Visible to all roles: account actions live in Settings (My Account) and My Profile. -->
                <ui:NavigationViewItem Style="{StaticResource WttNavItemStyle}" Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.Header>
                <Border Padding="24,8,24,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Alarm Bell with Badge + Beep Toggle In-Out -->
                        <Button Style="{StaticResource NeutralBtn}" ToolTip="Active Alarms" Margin="0,0,6,0" Command="{Binding OpenAlarmsCommand}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Alert24" />
                                <Border CornerRadius="8" Background="#E53935" MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" Visibility="{Binding HasActiveAlarms, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ActiveAlarmCount}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                            <!-- <CheckBox IsChecked="{Binding IsBeepEnabled}" Content="Beep" ToolTip="Beep Silent/ON (Critical/High only)" VerticalAlignment="Center" Margin="0,0,12,0" /> -->
                            <!-- Compact account entry: full profile opens on its own page. -->
                            <Button Style="{StaticResource NeutralBtn}" ToolTip="My Profile"
                                    Command="{Binding OpenProfileCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Account" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="1" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="600" />
    </Grid>
</Window>
