<ui:FluentWindow x:Class="WTT.UI.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:WTT.UI.Views.Pages"
        Title="WTT — Industrial Data Acquisition" Height="800" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WTT — Industrial Data Acquisition">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="DataArea24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" OpenPaneLength="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="Devices" Icon="{ui:SymbolIcon Router24}" TargetPageType="{x:Type pages:DevicesPage}"
                                       Visibility="{Binding CanViewDevices, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Live Data" Icon="{ui:SymbolIcon PulseSquare24}" TargetPageType="{x:Type pages:LiveDataPage}"
                                       Visibility="{Binding CanViewLiveData, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Data Transfer" Icon="{ui:SymbolIcon ArrowSync24}" TargetPageType="{x:Type pages:DataTransferPage}"
                                       Visibility="{Binding CanViewTransfer, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Users" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type pages:UsersPage}"
                                       Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}" />
                <ui:NavigationViewItem Content="Logs" Icon="{ui:SymbolIcon DocumentText24}" TargetPageType="{x:Type pages:LogViewerPage}"
                                       Visibility="{Binding CanViewLogs, Converter={StaticResource BoolToVis}}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}"
                                       Visibility="{Binding CanManageSettings, Converter={StaticResource BoolToVis}}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.Header>
                <Border Padding="24,8,24,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.ColumnSpan="2" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="18" Margin="0,0,6,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" · " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Run Text="{Binding RoleName, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <ui:Button Icon="{ui:SymbolIcon Key24}" ToolTip="Change my password" Appearance="Secondary" Margin="0,0,6,0"
                                       Command="{Binding ChangePasswordCommand}" />
                            <ui:Button Content="Sign out" Icon="{ui:SymbolIcon SignOut24}" Appearance="Secondary" Command="{Binding LogoutCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <ContentPresenter x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
