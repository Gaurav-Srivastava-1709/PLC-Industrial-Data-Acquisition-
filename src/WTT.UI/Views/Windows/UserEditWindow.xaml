<ui:FluentWindow x:Class="WTT.UI.Views.Windows.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="520" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <StackPanel Visibility="{Binding ShowProfile, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Username *" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" />
                <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" />
                <CheckBox Content="Account active" IsChecked="{Binding IsActive}" Margin="0,12,0,0" Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
            <StackPanel Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Password *" Style="{StaticResource FieldLabel}" />
                <ui:PasswordBox x:Name="PwdBox" PasswordChanged="Pwd_Changed" />
                <TextBlock Text="Confirm password *" Style="{StaticResource FieldLabel}" />
                <ui:PasswordBox x:Name="ConfirmBox" PasswordChanged="Confirm_Changed" />
                <TextBlock Style="{StaticResource Hint}" Text="Minimum 8 characters with upper and lower case letters and a digit. The user will be asked to change it at first login." />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
