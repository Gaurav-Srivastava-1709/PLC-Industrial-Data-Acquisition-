<ui:FluentWindow x:Class="WTT.UI.Views.Windows.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding WindowTitle}" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,12,24,12">
            
            <!-- Error Message -->
            <ui:InfoBar IsOpen="{Binding HasErrors}" Severity="Error" Title="Error"
                        Message="{Binding ErrorMessage}" Margin="0,0,0,16"/>
            
            <TextBlock Text="Username" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Enter login username" Margin="0,0,0,16" 
                        IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}"/>

            <TextBlock Text="Full Name" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Enter full display name" Margin="0,0,0,16"/>

            <TextBlock Text="Role" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" Margin="0,0,0,16"/>

            <TextBlock Text="Password" Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <ui:TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="{Binding IsEditMode, Converter={StaticResource PasswordPlaceholderConverter}}" Margin="0,0,0,16"/>
            
            <CheckBox IsChecked="{Binding IsActive}" Content="Is Active User" Margin="0,8,0,0"/>
            <TextBlock Text="Inactive users cannot log into the system." FontSize="11" Margin="24,2,0,0"
                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCommand}" 
                           HorizontalAlignment="Stretch" Appearance="Secondary"/>
                <ui:Button Grid.Column="2" Content="Save User" Command="{Binding SaveCommand}" 
                           HorizontalAlignment="Stretch" Appearance="Primary" Icon="Save24"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
