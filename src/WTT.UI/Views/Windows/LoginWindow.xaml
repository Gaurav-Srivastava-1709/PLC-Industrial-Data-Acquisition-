<Window x:Class="WTT.UI.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WTT — Sign in" Height="598" Width="912" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Colours are defined here on purpose: the sign-in screen keeps the same look
         in both application themes (the app itself is dark/light switchable).
         The card floats on a transparent window — no backdrop. -->
    <Window.Resources>
        <ResourceDictionary>

            <LinearGradientBrush x:Key="PeachPanel" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FCDEC9" Offset="0" />
                <GradientStop Color="#F6C2A2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ModuleBody" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF9A6B" Offset="0" />
                <GradientStop Color="#F26E3C" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="CardBrush" Color="#FFFCFA" />
            <SolidColorBrush x:Key="InkBrush" Color="#2C2A28" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="#7B6A5F" />
            <SolidColorBrush x:Key="InkFaintBrush" Color="#A6958A" />
            <SolidColorBrush x:Key="AccentBrush" Color="#DE5F38" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#C7502C" />
            <SolidColorBrush x:Key="AccentOffBrush" Color="#F0B39B" />
            <SolidColorBrush x:Key="GreenBrush" Color="#2E8B57" />
            <SolidColorBrush x:Key="LinkBrush" Color="#2F6BE0" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
            <SolidColorBrush x:Key="FieldBorderBrush" Color="#EBDDD2" />

            <!-- Rounded input shell with a soft border that lights up on focus -->
            <Style x:Key="LoginShell" TargetType="Border">
                <Setter Property="Background" Value="#FBF4EF" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Height" Value="50" />
                <Setter Property="SnapsToDevicePixels" Value="False" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#5B4B41" />
            </Style>

            <!-- Chrome-less text input, vertically centred in the 50px shell -->
            <Style x:Key="LoginInput" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
                <Setter Property="SelectionBrush" Value="#F7C7B2" />
                <Setter Property="SelectionOpacity" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="Transparent" VerticalAlignment="Center">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Same chrome-less look for the password field. Declared separately:
                 a TextBox template cannot be used on a PasswordBox. -->
            <Style x:Key="LoginInputPassword" TargetType="PasswordBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
                <Setter Property="SelectionBrush" Value="#F7C7B2" />
                <Setter Property="SelectionOpacity" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="Transparent" VerticalAlignment="Center">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary coral pill button -->
            <Style x:Key="LoginPrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="54" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="15.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{StaticResource AccentBrush}"
                                    CornerRadius="27" SnapsToDevicePixels="False">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentOffBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#F6BCA5" />
                                    <Setter TargetName="Surface" Property="BorderThickness" Value="3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small round icon button (close, reveal password) -->
            <Style x:Key="LoginIconButton" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="Transparent" CornerRadius="18" SnapsToDevicePixels="False">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#F3E4DA" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#E7D2C4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Card fills the whole window: nothing is painted behind it -->
        <Border x:Name="CardSurface" CornerRadius="28" Background="{StaticResource CardBrush}"
                BorderBrush="#FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= Illustration panel =================
                     Doubles as the window drag handle: the window has no OS chrome
                     and the card fills it edge to edge. -->
                <Border Grid.Column="0" Background="{StaticResource PeachPanel}" CornerRadius="28,0,0,28"
                        MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                    <Grid>
                        <Canvas Width="340" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- cloud -->
                            <Ellipse Canvas.Left="34" Canvas.Top="54" Width="56" Height="42" Fill="White" Opacity="0.92" />
                            <Ellipse Canvas.Left="62" Canvas.Top="42" Width="62" Height="46" Fill="White" Opacity="0.92" />
                            <Rectangle Canvas.Left="44" Canvas.Top="72" Width="72" Height="22" RadiusX="11" RadiusY="11"
                                       Fill="White" Opacity="0.92" />

                            <!-- signal mast above the controller -->
                            <Rectangle Canvas.Left="166.5" Canvas.Top="74" Width="7" Height="30" RadiusX="3.5" RadiusY="3.5" Fill="#2E8B57" />
                            <Ellipse Canvas.Left="160" Canvas.Top="54" Width="20" Height="20" Fill="#3FBF6F" />
                            <Path Data="M 146,44 C 136,54 136,70 146,80" Stroke="#3FBF6F" StrokeThickness="5" Fill="Transparent" />
                            <Path Data="M 194,44 C 204,54 204,70 194,80" Stroke="#3FBF6F" StrokeThickness="5" Fill="Transparent" />
                            <!-- round tips for the signal arcs (round line caps are not available here) -->
                            <Ellipse Canvas.Left="143.5" Canvas.Top="41.5" Width="5" Height="5" Fill="#3FBF6F" />
                            <Ellipse Canvas.Left="143.5" Canvas.Top="77.5" Width="5" Height="5" Fill="#3FBF6F" />
                            <Ellipse Canvas.Left="191.5" Canvas.Top="41.5" Width="5" Height="5" Fill="#3FBF6F" />
                            <Ellipse Canvas.Left="191.5" Canvas.Top="77.5" Width="5" Height="5" Fill="#3FBF6F" />

                            <!-- ground shadow -->
                            <Ellipse Canvas.Left="88" Canvas.Top="250" Width="164" Height="22" Fill="#EFB193" Opacity="0.45" />

                            <!-- SQL store -->
                            <Ellipse Canvas.Left="30" Canvas.Top="150" Width="60" Height="20" Fill="#6E7BF5" />
                            <Rectangle Canvas.Left="30" Canvas.Top="160" Width="60" Height="38" Fill="#6E7BF5" />
                            <Ellipse Canvas.Left="30" Canvas.Top="188" Width="60" Height="20" Fill="#4F5FDB" />
                            <Rectangle Canvas.Left="30" Canvas.Top="166" Width="60" Height="4" Fill="White" Opacity="0.4" />
                            <Rectangle Canvas.Left="30" Canvas.Top="184" Width="60" Height="4" Fill="White" Opacity="0.4" />

                            <!-- packets in flight -->
                            <Ellipse Canvas.Left="2" Canvas.Top="128" Width="14" Height="14" Fill="#A6B0FF" />
                            <Ellipse Canvas.Left="14" Canvas.Top="106" Width="10" Height="10" Fill="#A6B0FF" />
                            <Ellipse Canvas.Left="23" Canvas.Top="88" Width="7" Height="7" Fill="#A6B0FF" />

                            <!-- controller body -->
                            <Rectangle Canvas.Left="96" Canvas.Top="112" Width="152" Height="140"
                                       RadiusX="22" RadiusY="22" Fill="{StaticResource ModuleBody}" />
                            <Rectangle Canvas.Left="96" Canvas.Top="98" Width="152" Height="30"
                                       RadiusX="12" RadiusY="12" Fill="#FF7C4C" />
                            <Rectangle Canvas.Left="126" Canvas.Top="88" Width="92" Height="14"
                                       RadiusX="7" RadiusY="7" Fill="#FF9767" />

                            <!-- status lamps -->
                            <Ellipse Canvas.Left="219" Canvas.Top="103" Width="20" Height="20" Fill="#3FBF6F" Opacity="0.22" />
                            <Ellipse Canvas.Left="222" Canvas.Top="106" Width="14" Height="14" Fill="#3FBF6F" />
                            <Ellipse Canvas.Left="198" Canvas.Top="108" Width="10" Height="10" Fill="#FFC857" />

                            <!-- face -->
                            <Ellipse Canvas.Left="126" Canvas.Top="152" Width="20" Height="20" Fill="#2C2A28" />
                            <Ellipse Canvas.Left="196" Canvas.Top="152" Width="20" Height="20" Fill="#2C2A28" />
                            <Ellipse Canvas.Left="132" Canvas.Top="156" Width="7" Height="7" Fill="White" />
                            <Ellipse Canvas.Left="202" Canvas.Top="156" Width="7" Height="7" Fill="White" />
                            <Ellipse Canvas.Left="110" Canvas.Top="176" Width="20" Height="12" Fill="#FF7A6B" Opacity="0.5" />
                            <Ellipse Canvas.Left="212" Canvas.Top="176" Width="20" Height="12" Fill="#FF7A6B" Opacity="0.5" />
                            <Path Data="M 150,178 C 158,196 184,196 192,178 C 184,188 158,188 150,178 Z" Fill="#2C2A28" />

                            <!-- terminal strip -->
                            <Rectangle Canvas.Left="112" Canvas.Top="222" Width="120" Height="22"
                                       RadiusX="8" RadiusY="8" Fill="White" Opacity="0.2" />
                            <Rectangle Canvas.Left="124" Canvas.Top="228" Width="14" Height="10" RadiusX="3" RadiusY="3" Fill="#FFE0CF" />
                            <Rectangle Canvas.Left="146" Canvas.Top="228" Width="14" Height="10" RadiusX="3" RadiusY="3" Fill="#FFE0CF" />
                            <Rectangle Canvas.Left="168" Canvas.Top="228" Width="14" Height="10" RadiusX="3" RadiusY="3" Fill="#FFE0CF" />
                            <Rectangle Canvas.Left="190" Canvas.Top="228" Width="14" Height="10" RadiusX="3" RadiusY="3" Fill="#FFE0CF" />

                            <!-- sparkles -->
                            <Path Data="M 0,-11 C 2.5,-3 3,-2.5 11,0 C 3,2.5 2.5,3 0,11 C -2.5,3 -3,2.5 -11,0 C -3,-2.5 -2.5,-3 0,-11 Z"
                                  Canvas.Left="45" Canvas.Top="103" Fill="#F06292" />
                            <Path Data="M 0,-11 C 2.5,-3 3,-2.5 11,0 C 3,2.5 2.5,3 0,11 C -2.5,3 -3,2.5 -11,0 C -3,-2.5 -2.5,-3 0,-11 Z"
                                  Canvas.Left="272" Canvas.Top="135" Fill="#F06292" />
                            <Path Data="M 0,-8 C 2,-2 2,-2 8,0 C 2,2 2,2 0,8 C -2,2 -2,2 -8,0 C -2,-2 -2,-2 0,-8 Z"
                                  Canvas.Left="248" Canvas.Top="46" Fill="#F5B93B" />
                        </Canvas>

                        <!-- capability pill -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                                Background="White" CornerRadius="16" Padding="18,9">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#3FBF6F" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <TextBlock Text="Siemens S7 · Modbus TCP · SQL Server" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= Form panel ================= -->
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="0,28,28,0">
                    <StackPanel Margin="52,24,48,24" VerticalAlignment="Center">

                        <!-- brand -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="11" Background="#E3F5EA">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="18" Foreground="{StaticResource GreenBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="WTT" FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="19" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Text="Industrial Data Acquisition" FontSize="10.5" Foreground="#8A9A90" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Hello again, operator!" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                   Margin="0,18,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Sign in to your acquisition workspace."
                                   FontSize="13.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,5,0,0"
                                   TextWrapping="Wrap" />

                        <!-- session notice (e.g. session expired) -->
                        <Border Background="#EAF3FF" BorderBrush="#CFE0F7" BorderThickness="1" CornerRadius="12"
                                Padding="14,10" Margin="0,14,0,0"
                                Visibility="{Binding InfoMessage, Converter={StaticResource NotNullToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{StaticResource LinkBrush}"
                                               VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding InfoMessage}" FontSize="12.5"
                                           Foreground="#2A4C7D" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- username -->
                        <TextBlock Text="Username" Style="{StaticResource LoginFieldLabel}" Margin="0,16,0,6" />
                        <Border Style="{StaticResource LoginShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Person24" FontSize="17" Foreground="{StaticResource InkFaintBrush}"
                                               VerticalAlignment="Center" Margin="16,0,10,0" />
                                <TextBox x:Name="UsernameBox" Grid.Column="1" Style="{StaticResource LoginInput}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,16,0" />
                            </Grid>
                        </Border>

                        <!-- password -->
                        <TextBlock Text="Password" Style="{StaticResource LoginFieldLabel}" Margin="0,12,0,6" />
                        <Border Style="{StaticResource LoginShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Password24" FontSize="17" Foreground="{StaticResource InkFaintBrush}"
                                               VerticalAlignment="Center" Margin="16,0,10,0" />
                                <PasswordBox x:Name="PasswordBox" Grid.Column="1" Style="{StaticResource LoginInputPassword}"
                                             PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,4,0" />
                                <TextBox x:Name="PlainPasswordBox" Grid.Column="1" Style="{StaticResource LoginInput}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,4,0" Visibility="Collapsed" />
                                <Button x:Name="RevealPasswordButton" Grid.Column="2" Style="{StaticResource LoginIconButton}"
                                        Margin="0,0,7,0" Click="RevealPassword_Click" ToolTip="Show password">
                                    <Grid>
                                        <ui:SymbolIcon x:Name="EyeShowIcon" Symbol="Eye24" FontSize="16"
                                                       Foreground="{StaticResource InkSoftBrush}" />
                                        <ui:SymbolIcon x:Name="EyeHideIcon" Symbol="EyeOff24" FontSize="16"
                                                       Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- error -->
                        <Border Background="#FDEEEE" BorderBrush="#F6CFCF" BorderThickness="1" CornerRadius="12"
                                Padding="14,10" Margin="0,12,0,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Foreground="{StaticResource ErrorBrush}"
                                               VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12.5"
                                           Foreground="#8E2020" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- sign in -->
                        <Button Style="{StaticResource LoginPrimaryButton}" Command="{Binding LoginCommand}"
                                IsDefault="True" IsEnabled="{Binding CanSignIn}" Margin="0,18,0,0">
                            <Grid>
                                <TextBlock Text="Sign in  →" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Signing in…" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>

                        <!-- footer -->
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,14,0,0">
                            <Run Text="No account yet? " />
                            <Run Text="Ask your administrator" Foreground="{StaticResource LinkBrush}" FontWeight="SemiBold" />
                            <Run Text=" for access." />
                        </TextBlock>
                        <TextBlock Text="Authorised users only" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource InkFaintBrush}" Margin="0,6,0,0" />

                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Close (the window has no OS chrome, so it sits on top of the card) -->
        <Button Style="{StaticResource LoginIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,16,0" Click="CloseButton_Click" ToolTip="Close">
            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" Stroke="#8A7869" StrokeThickness="2" />
        </Button>
    </Grid>
</Window>
