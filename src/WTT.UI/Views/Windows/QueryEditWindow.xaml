<ui:FluentWindow x:Class="WTT.UI.Views.Windows.QueryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="640" Width="620" MinWidth="540"
        Icon="pack://application:,,,/Resources/WTTLogo.png"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Query name *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="CurrentBatch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding QueryTypes}" SelectedItem="{Binding QueryType}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="SQL Server connection" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Server *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="SERVER\INSTANCE" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Database *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="Windows authentication (integrated security)" IsChecked="{Binding UseIntegratedSecurity}" Margin="0,8,0,0" />
                <Grid Visibility="{Binding UseIntegratedSecurity, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="User id" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <ui:PasswordBox x:Name="PwdBox" PasswordChanged="Pwd_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Text="Leave empty to keep the stored password." Visibility="{Binding HasStoredPassword, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Encrypt" IsChecked="{Binding Encrypt}" Margin="0,0,16,0" />
                    <CheckBox Content="Trust server certificate" IsChecked="{Binding TrustServerCertificate}" />
                </StackPanel>

                <TextBlock Text="SELECT statement * (first row is used)" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <ui:TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" />
                <TextBlock Style="{StaticResource Hint}" Text="After saving, press Verify on the query to discover its columns. Only then can external tags be bound to it." />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource NeutralBtn}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource ExportBtn}" Command="{Binding SaveCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
