<ui:FluentWindow x:Class="WTT.UI.Views.Windows.AdminEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WTT - Secure setup" Height="600" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="WTT secure first-run setup" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="40,20,40,32" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ShieldLock24" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <TextBlock Text="Create the first administrator" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
            <TextBlock Text="No default password exists. Choose credentials known only to your organization." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource PageSubtitle}" Margin="0,0,0,18" />
            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox PasswordChanged="Password_PasswordChanged" />
            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox PasswordChanged="ConfirmPassword_PasswordChanged" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            <ui:Button Content="Create administrator" Appearance="Primary" Command="{Binding EnrollCommand}" IsDefault="True" Height="38" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
