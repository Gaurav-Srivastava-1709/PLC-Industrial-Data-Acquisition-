<ui:FluentWindow x:Class="WTT.UI.Views.Windows.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="700" Width="560" MinHeight="520" MinWidth="500"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Tag name *" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="unique per device" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Alias (display name)" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- PLC -->
                <StackPanel Visibility="{Binding IsPlc, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PLC address *" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding PlcAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    <TextBlock Text="{Binding AddressHint}" Style="{StaticResource Hint}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Data type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0" Visibility="{Binding IsModbus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Register type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding RegisterType}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Elements / string length" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox Value="{Binding ElementCount}" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding IsModbus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Address block (optional)" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding Block}" DisplayMemberPath="TagPrefix" />
                    </StackPanel>

                    <TextBlock Text="Scaling &amp; presentation" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Scale factor" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding ScaleFactor, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PlaceholderText="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Offset" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding ScaleOffset, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PlaceholderText="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Decimals" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PlaceholderText="auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding EngineeringUnit, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="°C" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="engineering = raw × scale + offset. Leave empty for raw values." />

                    <TextBlock Text="Write safety" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
                    <CheckBox Content="Explicitly allow writes to this PLC tag" IsChecked="{Binding IsWriteEnabled}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Minimum" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding WriteMinimum, TargetNullValue=''}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Maximum" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding WriteMaximum, TargetNullValue=''}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Cooldown (ms)" Style="{StaticResource FieldLabel}"/><ui:NumberBox Value="{Binding MinimumWriteIntervalMs}" Minimum="250" Maximum="60000"/></StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Writes are denied by default. Safe writes enforce type/range, cooldown and controller readback verification." />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Test read" Icon="{ui:SymbolIcon Play24}" Command="{Binding TestReadCommand}" />
                        <TextBlock Text="{Binding ReadResult}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </StackPanel>

                <!-- Custom -->
                <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Value" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding SetValue, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="constant value stamped into every scan" />
                    <TextBlock Style="{StaticResource Hint}" Text="Custom tags are not read from the controller. Their value is written into the historian with every scan, so downstream reports can pivot on it (line id, recipe, product code…)." />
                </StackPanel>

                <!-- External -->
                <StackPanel Visibility="{Binding IsExternal, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Verified query *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Queries}" SelectedItem="{Binding Query}" DisplayMemberPath="Name" />
                    <TextBlock Text="Column *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding Column}" DisplayMemberPath="ColumnName" />
                    <TextBlock Style="{StaticResource Hint}" Text="Only verified queries are listed. The first-row value of the chosen column is copied into this tag each time the capture trigger switches ON." />
                </StackPanel>

                <CheckBox Content="Included in polling / capture" IsChecked="{Binding IsSelected}" Margin="0,16,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
