<ui:FluentWindow x:Class="WTT.UI.Views.Windows.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tag Configuration" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Configure PLC Tag" />

        <ScrollViewer Grid.Row="1" Padding="24,12,24,12">
            <StackPanel>
                <TextBlock Text="Tag Name" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Tag.TagName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Boiler_Temperature" Margin="0,0,0,12"/>

                <TextBlock Text="PLC Memory Address" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Tag.Address, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 40001 (Modbus) or DB1.DBD0" Margin="0,0,0,12"/>

                <TextBlock Text="Data Type" FontWeight="Medium" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding Tag.DataType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,0,12">
                    <ComboBoxItem Content="Float"/>
                    <ComboBoxItem Content="Int16"/>
                    <ComboBoxItem Content="Int32"/>
                    <ComboBoxItem Content="Bool"/>
                    <ComboBoxItem Content="String"/>
                </ComboBox>

                <TextBlock Text="Description (Optional)" FontWeight="Medium" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Tag.Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Main steam pipe temperature sensor" Margin="0,0,0,12"/>

                <CheckBox Content="Is Active (Enable for polling)" IsChecked="{Binding Tag.IsActive, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12,24,16" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <ui:Button Content="Save Tag" Appearance="Primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
