<Page x:Class="WTT.UI.Views.Pages.LiveDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Live data">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Live data" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Current values refreshed from the WTT Windows Service through SQL Server." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="240" Margin="0,0,8,0" />
                <ui:TextBox PlaceholderText="Filter…" Icon="{ui:SymbolIcon Search24}" Width="200" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource Dot}" Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Margin="24,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding GoodCount, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold" /><Run Text=" good · " />
                    <Run Text="{Binding BadCount, Mode=OneWay}" Foreground="{StaticResource BadBrush}" FontWeight="SemiBold" /><Run Text=" not good · last scan " />
                    <Run Text="{Binding LastScanUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Rows}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1"
                      CanUserResizeColumns="True" CanUserReorderColumns="False">
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle><DataGrid.Resources>
                <Style TargetType="TextBlock" x:Key="TrimCell">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveAlarm}" Value="True">
                            <Setter Property="Background" Value="#26FF3B30" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Changed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(DataGridRow.Background).(SolidColorBrush.Color)" From="#3D4FA3FF" To="Transparent" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasActiveAlarm}" Value="True">
                            <Setter Property="ToolTip" Value="{Binding AlarmStatus}" />
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Background"><Setter.Value><SolidColorBrush Color="Transparent" /></Setter.Value></Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="28" MinWidth="28" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Style="{StaticResource Dot}" Width="9" Height="9" Margin="0" HorizontalAlignment="Center" Fill="{Binding Quality, Converter={StaticResource QualityToBrush}}" ToolTip="{Binding Quality}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tag" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Address / kind" Binding="{Binding Address}" Width="120" MinWidth="100" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="70" MinWidth="65" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="135" MinWidth="110" FontFamily="Consolas" FontWeight="SemiBold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimCell}"><Setter Property="ToolTip" Value="{Binding Value}" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveAlarm}" Value="True"><Setter Property="Foreground" Value="#FFFF3B30" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55" MinWidth="50" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Min" Binding="{Binding MinDisplay}" Width="65" MinWidth="60" />
                <DataGridTextColumn Header="Max" Binding="{Binding MaxDisplay}" Width="65" MinWidth="60" />
                <DataGridTemplateColumn Header="Alarm" Width="95" MinWidth="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="—" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlarmEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border CornerRadius="4" Padding="6,1" Visibility="{Binding IsAlarmEnabled, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveAlarm}" Value="True">
                                                    <Setter Property="Background" Value="#FFFF3B30" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAlarmEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasActiveAlarm}" Value="True">
                                                    <Setter Property="Background" Value="#FFFF3B30" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AlarmStatus}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveAlarm}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AlarmPriority, StringFormat= ({0})}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="65" MinWidth="60" />
                <DataGridTextColumn Header="Updated" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss.fff}" Width="130" MinWidth="120" FontFamily="Consolas" />
                <DataGridTemplateColumn Header="Action" Width="100" MinWidth="96" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Write" Icon="{ui:SymbolIcon Edit24}" FontSize="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center" Appearance="Secondary" ToolTip="Write value to PLC"
                                        Command="{Binding DataContext.WriteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsWritable}"
                                       Visibility="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            </DataGrid>

            <!-- Loading overlay for the INITIAL open. Driven by IsInitialLoad (a flag that
                 clears once the first load finishes) AND IsBusy (so a failed first load
                 cannot leave it spinning). It deliberately does NOT use IsBusy alone or
                 "Rows.Count == 0": the status timer re-reads every 2 s, and a device with
                 zero selected tags keeps Rows permanently empty, so either of those would
                 strobe the spinner on every refresh. -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInitialLoad}" Value="True" />
                                    <Condition Binding="{Binding IsBusy}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="34" Height="34" />
                    <TextBlock Text="Loading live values…" Margin="0,12,0,0" HorizontalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
