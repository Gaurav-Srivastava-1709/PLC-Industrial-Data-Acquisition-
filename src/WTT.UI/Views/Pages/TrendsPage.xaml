<Page x:Class="WTT.UI.Views.Pages.TrendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:WTT.UI.Controls"
      xmlns:vm="clr-namespace:WTT.UI.ViewModels"
      Title="Historian Trends" ScrollViewer.CanContentScroll="False">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Historian Trends" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Multi-pen real-time and historical process trends across all PLC machines." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <!-- Device Selector -->
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="220" Margin="0,0,8,6" />

                <!-- Time Window Selector Buttons -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="2" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="1m" Command="{Binding SetTimeWindowCommand}" CommandParameter="1" Padding="8,4" Margin="1" Appearance="Transparent" />
                        <ui:Button Content="5m" Command="{Binding SetTimeWindowCommand}" CommandParameter="5" Padding="8,4" Margin="1" Appearance="Transparent" />
                        <ui:Button Content="15m" Command="{Binding SetTimeWindowCommand}" CommandParameter="15" Padding="8,4" Margin="1" Appearance="Transparent" />
                        <ui:Button Content="30m" Command="{Binding SetTimeWindowCommand}" CommandParameter="30" Padding="8,4" Margin="1" Appearance="Transparent" />
                        <ui:Button Content="1h" Command="{Binding SetTimeWindowCommand}" CommandParameter="60" Padding="8,4" Margin="1" Appearance="Transparent" />
                    </StackPanel>
                </Border>

                <!-- Live Stream Toggle -->
                <ui:Button Content="{Binding LiveStatusText}"
                           Icon="{ui:SymbolIcon Play24}"
                           Command="{Binding ToggleLiveCommand}"
                           Appearance="Secondary" Margin="0,0,8,6" />

                <!-- Y-mode: Shared vs Normalized (mixed units) -->
                <ui:Button Content="{Binding YModeLabel}"
                           Icon="{ui:SymbolIcon DataHistogram24}"
                           ToolTip="Toggle Shared Y / Normalized 0-100% (mixed units ke liye)"
                           Command="{Binding ToggleYModeCommand}"
                           Appearance="Secondary" Margin="0,0,8,6" />

                <!-- Reset pan/zoom -->
                <ui:Button Content="Reset View"
                           Icon="{ui:SymbolIcon ArrowReset24}"
                           ToolTip="Pan/Zoom reset — double-click chart par bhi hota hai"
                           Command="{Binding ResetViewCommand}"
                           Margin="0,0,8,6" />

                <!-- Export CSV -->
                <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Full-resolution CSV (10k points)" Command="{Binding ExportCsvCommand}" Margin="0,0,8,6" />

                <!-- Export PNG (poora card: legend + chart + hint — industry report jaisa) -->
                <ui:Button Content="Export PNG" Icon="{ui:SymbolIcon Image24}"
                           ToolTip="Chart ka screenshot PNG me save karo"
                           Command="{Binding ExportPngCommand}" CommandParameter="{Binding ElementName=TrendCard}"
                           Margin="0,0,8,6" />

                <!-- Refresh -->
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh Window" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
            </WrapPanel>
            <!-- Mixed-units warning -->
            <TextBlock Grid.Row="2" Text="{Binding UnitsWarning}" Foreground="#FFB300" FontSize="12" Margin="0,6,0,0"
                       Visibility="{Binding HasMixedUnits, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
        </Grid>

        <!-- Main Trend Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Tag Checklist -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Pens (Tags)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                    <!-- Search Filter -->
                    <ui:TextBox Grid.Row="1" PlaceholderText="Filter tags…" Icon="{ui:SymbolIcon Search24}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                    <!-- Tag List with Checkboxes -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagTrendItem}">
                                    <Border CornerRadius="4" Padding="6,4" Margin="0,0,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="130" ToolTip="{Binding DisplayName}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding LatestValue}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Select / Clear shortcuts -->
                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,8,0,0">
                        <ui:Button Content="Select All" Command="{Binding SelectAllTagsCommand}" Margin="0,0,4,0" Appearance="Transparent" FontSize="11" />
                        <ui:Button Content="Clear All" Command="{Binding ClearAllTagsCommand}" Margin="4,0,0,0" Appearance="Transparent" FontSize="11" />
                    </UniformGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Panel: Active Legend Bar + Custom Vector Chart -->
            <Border x:Name="TrendCard" Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Active Pen Legend Bar (click pen = hide/show) -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="84" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding ActiveSeries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controls:PenSeriesModel}">
                                    <ui:Button Padding="0" Margin="0,0,8,8" Appearance="Transparent"
                                               Command="{Binding DataContext.TogglePenVisibilityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Click to hide / show pen">
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{Binding StrokeBrush}" BorderThickness="1.5" CornerRadius="6" Padding="8,4" Opacity="{Binding IsVisible, Converter={StaticResource BoolToOpacity}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StrokeBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding CurrentValue, StringFormat={}{0:F2}}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding EngineeringUnit}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Hardware Accelerated SCADA Trend Vector Plot -->
                    <controls:ScadaTrendPlot x:Name="TrendPlot" Grid.Row="1"
                                             Series="{Binding ActiveSeries}"
                                             TimeWindow="{Binding TimeWindow}"
                                             IsLive="{Binding IsLive}"
                                             RenderRevision="{Binding TrendRevision}"
                                             YScaleMode="{Binding YScaleMode}"
                                             MinHeight="380" />

                    <!-- Status hint -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="Hover = values · Wheel = time zoom · Ctrl+Wheel = Y zoom · Drag = pan · Double-click = reset. Red X = sensor/PLC gap."
                                   Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11">
                            <Run Text="Window: " /><Run Text="{Binding TimeWindowLabel}" FontWeight="SemiBold" /><Run Text=" · Y: " /><Run Text="{Binding YModeLabel}" FontWeight="SemiBold" /><Run Text=" · Pens: " /><Run Text="{Binding ActivePenCount}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
