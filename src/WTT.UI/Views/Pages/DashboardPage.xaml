<Page x:Class="WTT.UI.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- Welcome Header -->
            <TextBlock Text="📊 Dashboard" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="System overview and quick actions" FontSize="14" Margin="0,0,0,24"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Stats Cards Row -->
            <UniformGrid Columns="4" Margin="0,0,0,24">

                <!-- Card 1: PLC Devices -->
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Router24" FontSize="32" Foreground="#3498DB" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="PLC Devices" FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Active Tags -->
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Tag24" FontSize="32" Foreground="#2ECC71" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Active Tags" FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Data Captured -->
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Database24" FontSize="32" Foreground="#E67E22" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Records Today" FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Errors -->
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="32" Foreground="#E74C3C" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Errors Today" FontSize="13" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- System Status Card -->
            <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="🔧 System Status" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data Capture Service" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#95A5A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Not Running" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data Transfer Service" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#95A5A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Not Running" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Database" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#2ECC71" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Connected (SQLite)" Foreground="#2ECC71"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <TextBlock Text="⚡ Quick Actions" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <WrapPanel>
                        <ui:Button Content="Add New Device" Icon="Add24" Appearance="Primary" Margin="0,0,12,8" IsEnabled="False"/>
                        <ui:Button Content="Start Data Capture" Icon="Play24" Margin="0,0,12,8" IsEnabled="False"/>
                        <ui:Button Content="Export Data (CSV)" Icon="ArrowDownload24" Margin="0,0,12,8" IsEnabled="False"/>
                        <ui:Button Content="View Logs" Icon="DocumentText24" Margin="0,0,12,8" IsEnabled="False"/>
                    </WrapPanel>
                    <TextBlock Text="(These features will be enabled in Phase 3+)" FontSize="12" FontStyle="Italic"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
