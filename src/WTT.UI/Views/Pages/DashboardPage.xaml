<Page x:Class="WTT.UI.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WTT.UI.ViewModels"
      Title="Dashboard" ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageRoot}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Live health of every device, the local buffer and the central transfer." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                </WrapPanel>
            </Grid>

            <!-- KPI row -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DevicesTotal}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Devices" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValue}">
                            <Run Text="{Binding DevicesConnected, Mode=OneWay}" /><Run Text=" / " FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding DevicesRunning, Mode=OneWay}" FontSize="16" />
                        </TextBlock>
                        <TextBlock Text="Connected / running" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ReadingsToday, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Readings today" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding BufferedReadings, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Waiting for transfer" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TransferredToday, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Transferred today" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorsToday, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Errors (session)" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Pipeline controls -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding IsServiceRunning, Converter={StaticResource BoolToBrush}}" />
                    <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" Margin="0,0,24,0" FontWeight="SemiBold" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Last transfer: " /><Run Text="{Binding LastTransferUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Live historian trend" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Hint}"/></StackPanel>
                    <Canvas Grid.Row="1" Height="84" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Polyline Points="{Binding ReadingTrend}" Stroke="{DynamicResource SystemAccentColorPrimaryBrush}" StrokeThickness="2.5" />
                        <Polyline Points="{Binding BufferTrend}" Stroke="#FFF59E0B" StrokeThickness="2" StrokeDashArray="4,2" />
                    </Canvas>
                </Grid>
            </Border>

            <!-- Device tiles -->
            <TextBlock Grid.Row="4" Text="No devices configured yet. Go to Devices to add your first PLC." Style="{StaticResource PageSubtitle}"
                       Visibility="{Binding Devices.Count, Converter={StaticResource CountToVis}, ConverterParameter=zero}" />
            <ItemsControl Grid.Row="4" ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">
                        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot}" ToolTip="{Binding StatusText}">
                                            <Ellipse.Fill>
                                                <MultiBinding Converter="{StaticResource DeviceStatusToBrush}">
                                                    <Binding Path="IsRunning" />
                                                    <Binding Path="IsConnected" />
                                                    <Binding Path="LastError" />
                                                </MultiBinding>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ScanCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                                        <TextBlock Text="scans" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ReadingsWritten, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                                        <TextBlock Text="readings" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding ErrorCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                                        <TextBlock Text="errors" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}">
                                    <Run Text="Mode: " /><Run Text="{Binding Mode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding TriggerText, Mode=OneWay}" FontWeight="SemiBold" />
                                    <LineBreak /><Run Text="Last scan: " /><Run Text="{Binding LastScanUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss}" />
                                </TextBlock>
                                <TextBlock Text="{Binding LastError}" Style="{StaticResource ErrorText}" FontSize="11" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding LastError, Converter={StaticResource NotNullToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:ToggleSwitch IsChecked="{Binding IsCaptureEnabled, Mode=OneWay}" OnContent="Capture" OffContent="Capture"
                                                     Command="{Binding DataContext.ToggleCaptureCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                     IsEnabled="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,12,0" />
                                    <ui:ToggleSwitch IsChecked="{Binding IsMonitorEnabled, Mode=OneWay}" OnContent="Monitor" OffContent="Monitor"
                                                     Command="{Binding DataContext.ToggleMonitorCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                     IsEnabled="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button Content="Live data" Icon="{ui:SymbolIcon PulseSquare24}" Margin="0,0,8,0"
                                               Command="{Binding DataContext.OpenLiveDataCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                    <ui:Button Content="Configure" Icon="{ui:SymbolIcon Settings24}"
                                               Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                               Visibility="{Binding DataContext.CanManageDevices, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
