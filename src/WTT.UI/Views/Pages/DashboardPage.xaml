<Page x:Class="WTT.UI.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WTT.UI.ViewModels"
      Title="Dashboard" ScrollViewer.CanContentScroll="False">
    <!-- Modern colourful KPI cards (Tailwind-admin inspired): fixed pastel
         gradients + saturated icon circles + bottom accent strips. Colours are
         FIXED (not theme brushes) so cards stay vibrant and dark text stays
         readable in both Light and Dark mode - on a dark canvas these glow
         like an industrial Andon board. Hover = gentle lift + soft shadow. -->
    <Page.Resources>
        <LinearGradientBrush x:Key="KpiBlueBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DBEAFE" Offset="0" />
            <GradientStop Color="#BFDBFE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KpiTealBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CCFBF1" Offset="0" />
            <GradientStop Color="#99F6E0" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KpiPurpleBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EDE9FE" Offset="0" />
            <GradientStop Color="#DDD6FE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KpiAmberBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FEF3C7" Offset="0" />
            <GradientStop Color="#FDE68A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KpiPinkBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FCE7F3" Offset="0" />
            <GradientStop Color="#FBCFE8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KpiRedBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FEE2E2" Offset="0" />
            <GradientStop Color="#FECACA" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <!-- Narrow cards: long captions wrap to 2 lines instead of clipping. -->
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <!-- Shared card shell: rounded pastel body, transparent 1px border
             (reserves space so hover never shifts layout), hover lifts the
             card 3px and adds a soft shadow + bright edge. -->
        <Style x:Key="ModernKpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="Padding" Value="14,14,14,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CCFFFFFF" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-3" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#40000000" BlurRadius="14"
                                              ShadowDepth="3" Direction="270" Opacity="0.45" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <!-- =======================================================================
         DASHBOARD - high-performance HMI layout (ISA-101.01 principles).

         This is a plant-floor operator console, so the layout is driven by two
         hard rules from the standard rather than by a web-dashboard look:

         1. "Level 1 - Overview ... an experienced operator should be able to
             assess overall plant state in under five seconds." The previous
             layout pushed every device tile below the fold behind a decorative
             hero banner and a 400 px chart. The banner is gone (gradients are
             an ISA-101 anti-pattern), the chart is 170 px, and the device list
             now starts around 430 px so tiles are visible on a 1080p screen.

         2. Colour means state, never decoration. Cards are neutral surfaces;
             only metrics that can genuinely be abnormal (buffer, errors,
             failed batches) take a semantic colour, and only when non-zero -
             a DataTrigger on Value="0" drops them back to muted, which is
             ISA-101's "display numeric values by exception" rule.

         Every binding, command and converter is unchanged from the previous
         version. Only layout, colour and type differ.
         ======================================================================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <!-- Transparent canvas: inherits the NavigationView content background,
             so Dashboard matches every other page (white in Light, dark
             surface in Dark). A fixed grey canvas is what made only this
             page look off. Cards carry their own bordered surfaces. -->
        <Border Background="Transparent">
            <Grid Margin="20,14,20,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============ HEADER: title + live status + actions ============
                     Replaces the old gradient hero banner. Same information, one
                     row instead of two, and no decorative gradient. -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Live health of every device, the local buffer and the central transfer."
                                   FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Service status, moved inline. The status dot keeps the
                         existing GoodBrush/NeutralBrush mapping, unchanged. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="24,0,16,0">
                        <Border Style="{StaticResource DashPill}" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Width="8" Height="8" Margin="0,0,7,0"
                                         Fill="{Binding IsServiceRunning, Converter={StaticResource BoolToBrush}}" />
                                <TextBlock Text="{Binding ServiceStatusText}" Style="{StaticResource DashPillText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DashRowLabel}" Text="Last transfer" Margin="0,0,6,0" />
                            <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding LastTransferUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Trends" Icon="{ui:SymbolIcon DataHistogram24}" Margin="0,0,8,0"
                                   Padding="12,6" Appearance="Secondary"
                                   Command="{Binding OpenTrendsCommand}" />
                        <Button Style="{StaticResource CoralRefreshBtn}" Command="{Binding RefreshCommand}" ToolTip="Refresh dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ==================== KPI STRIP (6 modern colour cards) ====================
                     Pastel gradient body + saturated icon circle + darker bottom
                     strip, like a modern admin template. Bindings unchanged. -->
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
                    <!-- 1 · Devices (blue) -->
                    <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiBlueBg}"
                            ToolTip="Total configured devices">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#2563EB" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Server24" Foreground="White" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DEVICES" Style="{StaticResource KpiLabel}" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DevicesTotal, StringFormat={}{0:N0}}"
                                                   Style="{StaticResource KpiValue}" />
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10"
                                    Background="#2563EB" Margin="-14,12,-14,0" />
                        </Grid>
                    </Border>

                    <!-- 2 · Connected / running (teal) -->
                    <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiTealBg}"
                            ToolTip="Connected devices / running capture workers">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#0D9488" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PlugConnected24" Foreground="White" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="CONNECTED / RUNNING" Style="{StaticResource KpiLabel}" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                        <TextBlock Style="{StaticResource KpiValue}">
                                            <Run Text="{Binding DevicesConnected, Mode=OneWay}" />
                                            <Run Text=" / " FontSize="14" Foreground="#475569" />
                                            <Run Text="{Binding DevicesRunning, Mode=OneWay}" FontSize="14" Foreground="#475569" />
                                        </TextBlock>
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10"
                                    Background="#0D9488" Margin="-14,12,-14,0" />
                        </Grid>
                    </Border>

                    <!-- 3 · Readings today (purple) -->
                    <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiPurpleBg}"
                            ToolTip="Readings captured today">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#7C3AED" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DataHistogram24" Foreground="White" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="READINGS TODAY" Style="{StaticResource KpiLabel}" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ReadingsToday, StringFormat={}{0:N0}}"
                                                   Style="{StaticResource KpiValue}" />
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10"
                                    Background="#7C3AED" Margin="-14,12,-14,0" />
                        </Grid>
                    </Border>

                    <!-- 4 · Waiting for transfer (amber) -->
                    <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiAmberBg}"
                            ToolTip="Buffered readings waiting for central transfer">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#D97706" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Database24" Foreground="White" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="WAITING FOR TRANSFER" Style="{StaticResource KpiLabel}" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding BufferedReadings, StringFormat={}{0:N0}}"
                                                   Style="{StaticResource KpiValue}" />
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10"
                                    Background="#D97706" Margin="-14,12,-14,0" />
                        </Grid>
                    </Border>

                    <!-- 5 · Transferred today (pink) -->
                    <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiPinkBg}"
                            ToolTip="Readings transferred to central today">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#DB2777" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TRANSFERRED TODAY" Style="{StaticResource KpiLabel}" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TransferredToday, StringFormat={}{0:N0}}"
                                                   Style="{StaticResource KpiValue}" />
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10"
                                    Background="#DB2777" Margin="-14,12,-14,0" />
                        </Grid>
                    </Border>

                    <!-- 6 · Errors (red) -->
                    <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiRedBg}"
                            Margin="0" ToolTip="Errors this session">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#DC2626" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="AlertUrgent24" Foreground="White" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ERRORS (SESSION)" Style="{StaticResource KpiLabel}" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ErrorsToday, StringFormat={}{0:N0}}"
                                                   Style="{StaticResource KpiValue}" />
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10"
                                    Background="#DC2626" Margin="-14,12,-14,0" />
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- =============== TREND CHART + PIPELINE HEALTH (one row) =============== -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="340" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" MinWidth="272" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ingestion &amp; buffer activity"
                                       Style="{StaticResource DashPanelTitle}" />
                            <TextBlock Grid.Row="1" Text="{Binding TrendSummary}"
                                       Style="{StaticResource DashPanelSubtitle}" Margin="0,1,0,6" />

                            <!-- The view model normalises its points into a 300 x 80 box
                                 (and maps a flat series to y = 80). The canvas is 300 x 96
                                 so that value is not clipped against the bottom edge, and
                                 Stretch="Uniform" scales it proportionally - the line is
                                 never distorted.

                                 A 300x96 box stretched to the full card width would need to be
                                 ~300 px tall, which is exactly the oversized empty chart this
                                 page had. So the plot is kept short and centred inside a
                                 tinted "well" that spans the card. The well is what makes the
                                 side margins read as deliberate chart padding rather than as
                                 a chart that failed to fill its box. -->
                            <Border Grid.Row="2" Height="170" CornerRadius="6" Padding="10,6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    ClipToBounds="True">
                                <Viewbox Stretch="Uniform" StretchDirection="Both"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Canvas Width="300" Height="96">
                                        <Line Style="{StaticResource DashChartGridLine}" X1="0" Y1="20" X2="300" Y2="20" />
                                        <Line Style="{StaticResource DashChartGridLine}" X1="0" Y1="40" X2="300" Y2="40" />
                                        <Line Style="{StaticResource DashChartGridLine}" X1="0" Y1="60" X2="300" Y2="60" />
                                        <Line Style="{StaticResource DashChartGridLine}" X1="0" Y1="80" X2="300" Y2="80" />
                                        <Polyline Points="{Binding ReadingTrend}"
                                                  Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Polyline Points="{Binding BufferTrend}"
                                                  Stroke="{DynamicResource SystemFillColorCautionBrush}"
                                                  StrokeThickness="1.2" StrokeDashArray="3,2" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Legend: shape + text as well as colour, so the two
                                 series stay distinguishable for a colour-blind
                                 operator (ISA-101 requires colour + shape + position). -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Border Width="14" Height="2" Background="{DynamicResource TextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Readings" Style="{StaticResource DashRowLabel}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding ReadingsToday, StringFormat={}{0:N0}}" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="2" Background="{DynamicResource SystemFillColorCautionBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Buffer" Style="{StaticResource DashRowLabel}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding BufferedReadings, StringFormat={}{0:N0}}" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pipeline health. Compact, no empty middle: the old version
                         stretched to match the chart and left a large blank block. -->
                    <Border Grid.Column="2" Style="{StaticResource DashCard}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Pipeline health" Style="{StaticResource DashPanelTitle}" />
                            <TextBlock Text="Why the buffer is or is not draining"
                                       Style="{StaticResource DashPanelSubtitle}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TRANSFERRED" Style="{StaticResource DashMiniLabel}" />
                                    <TextBlock Text="{Binding TransferredToday, StringFormat={}{0:N0}}"
                                               Style="{StaticResource DashMiniValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="WAITING" Style="{StaticResource DashMiniLabel}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding BufferedReadings, StringFormat={}{0:N0}}"
                                               Style="{StaticResource DashMiniValue}" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <Border Height="6" CornerRadius="999" Margin="0,8,0,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" ClipToBounds="True">
                                <Border Height="6" CornerRadius="999" HorizontalAlignment="Left"
                                        Background="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource RatioToWidth}" ConverterParameter="220">
                                            <Binding Path="TransferredToday" />
                                            <Binding Path="BufferedReadings" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>

                            <Border Style="{StaticResource DashDivider}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Failed batches today" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Grid.Column="2" Text="{Binding FailedBatchesToday, StringFormat={}{0:N0}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DashRowValue}">
                                            <!-- Critical when batches are failing, muted at zero. -->
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FailedBatchesToday}" Value="0">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Capture" Style="{StaticResource DashRowLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource DashPill}">
                                    <TextBlock Text="Paused" Style="{StaticResource DashPillText}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding CapturePaused, Converter={StaticResource BoolToVis}}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DashPill}">
                                    <TextBlock Text="Running" Style="{StaticResource DashPillText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding CapturePaused, Converter={StaticResource InverseBoolToVis}}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Transfer" Style="{StaticResource DashRowLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource DashPill}">
                                    <TextBlock Text="Paused" Style="{StaticResource DashPillText}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding TransferPaused, Converter={StaticResource BoolToVis}}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DashPill}">
                                    <TextBlock Text="Running" Style="{StaticResource DashPillText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding TransferPaused, Converter={StaticResource InverseBoolToVis}}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ DEVICE TILES SECTION HEADER ============================ -->
                <Grid Grid.Row="3" Margin="0,6,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Colorful section icon badge -->
                        <Border Background="#EEF2FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Server24" Foreground="#4F46E5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CONNECTED DEVICES" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Background="#E0E7FF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Devices.Count, StringFormat={}{0} Total}" FontSize="10.5" FontWeight="Bold" Foreground="#4338CA" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Real-time PLC nodes, communication channels &amp; acquisition controls"
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4">
                    <Border Background="{DynamicResource LayerFillColorAltBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="20" Margin="0,0,0,2"
                            Visibility="{Binding Devices.Count, Converter={StaticResource CountToVis}, ConverterParameter=zero}">
                        <TextBlock Text="No devices configured yet. Go to Devices to add your first PLC."
                                   FontSize="12" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">
                                <!-- Modern Industrial Device Card: 320px width, crisp border, soft multi-layer shadow, elevated hover -->
                                <Border Width="320" Margin="0,0,16,16" BorderThickness="1.5" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Card Shell: Clean soft surface with gentle Slate border -->
                                            <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.08" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- Hover: subtle lift, vibrant indigo border, and deeper shadow -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#6366F1" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#4F46E5" BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.22" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <!-- Critical Abnormal state: Running par connection fail / error.
                                                     Theme-aware brushes (light me halka pink, dark me dark red tint)
                                                     taaki dono mode me readable rahe. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRunning}" Value="True" />
                                                        <Condition Binding="{Binding IsConnected}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Top Status Accent Header Bar (Rich Slate Gradient) -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Main Card Body (Clean Content Container) -->
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 1. Top Header Accent Banner: Deep Slate-Blue Gradient with White/High-Contrast Text -->
                                        <Border Grid.Row="0" CornerRadius="11,11,0,0" Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="#0F172A">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#1E293B" Offset="0" />
                                                    <GradientStop Color="#0F172A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Device Icon + Big Bold Name + Protocol / IP summary -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource Dot}" Width="10" Height="10" Margin="0,0,8,0"
                                                                 ToolTip="{Binding StatusText}">
                                                            <Ellipse.Fill>
                                                                <MultiBinding Converter="{StaticResource DeviceStatusToBrush}">
                                                                    <Binding Path="IsRunning" />
                                                                    <Binding Path="IsConnected" />
                                                                    <Binding Path="LastError" />
                                                                </MultiBinding>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <!-- Device Title: Bada (15.5px) aur ExtraBold taaki turant nazar aaye -->
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                   FontWeight="ExtraBold" FontSize="15.5"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!-- Device Summary: Soft Blue-Grey tint for high readability -->
                                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                                               Foreground="#CBD5E1" FontWeight="SemiBold"
                                                               Margin="18,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Status Badge (Pill with dark border) -->
                                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="12" Padding="10,4"
                                                        Background="#334155" BorderBrush="#475569" BorderThickness="1">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource DeviceStatusToBrush}">
                                                                <Binding Path="IsRunning" />
                                                                <Binding Path="IsConnected" />
                                                                <Binding Path="LastError" />
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 2. Main Card Content Area -->
                                        <Border Grid.Row="1" Padding="14,13" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,11,11">
                                            <StackPanel>
                                                <!-- Metrics Strip: Scans (Cyan/Slate), Readings (Indigo), Errors (Rose) -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- SCANS Pod: Soft Indigo/Slate Tint with border -->
                                                    <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6,7" SnapsToDevicePixels="True">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ScanCount, StringFormat={}{0:N0}}"
                                                                       FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="SCANS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- READINGS Pod: Rich Vibrant Indigo Tint -->
                                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="6,7" SnapsToDevicePixels="True">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ReadingsWritten, StringFormat={}{0:N0}}"
                                                                       FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="READINGS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ERRORS Pod: Warm Alert Rose Tint -->
                                                    <Border Grid.Column="4" CornerRadius="8" Padding="6,7" SnapsToDevicePixels="True" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ErrorCount, StringFormat={}{0:N0}}"
                                                                       FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="ERRORS" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Metadata strip (Mode badge + Last Scan timestamp) -->
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Mode: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <!-- Colorful Amber/Indigo Mode Badge -->
                                                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="2,0,0,0">
                                                                <TextBlock Text="{Binding Mode, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TriggerText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#059669" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Clock20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Last scan: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding LastScanUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss, TargetNullValue=—, FallbackValue=—}"
                                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Error banner if any (theme-aware: dono mode me readable) -->
                                                <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10"
                                                        Visibility="{Binding LastError, Converter={StaticResource NotNullToVis}}">
                                                    <TextBlock Text="{Binding LastError}" Style="{StaticResource ErrorText}" FontSize="10.5"
                                                               Margin="0" TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Toggles: Capture & Monitor switches (SemiBold + Display formatting
                                                     taaki dark background par white label sharp dikhe, blur nahi) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <ui:ToggleSwitch IsChecked="{Binding IsCaptureEnabled, Mode=OneWay}"
                                                                     OnContent="Capture" OffContent="Capture"
                                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                     FontSize="13" FontWeight="SemiBold"
                                                                     TextOptions.TextFormattingMode="Display"
                                                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                                     Command="{Binding DataContext.ToggleCaptureCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                     CommandParameter="{Binding}"
                                                                     IsEnabled="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                     Margin="0,0,14,0" />
                                                    <ui:ToggleSwitch IsChecked="{Binding IsMonitorEnabled, Mode=OneWay}"
                                                                     OnContent="Monitor" OffContent="Monitor"
                                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                     FontSize="13" FontWeight="SemiBold"
                                                                     TextOptions.TextFormattingMode="Display"
                                                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                                     Command="{Binding DataContext.ToggleMonitorCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                     CommandParameter="{Binding}"
                                                                     IsEnabled="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}}" />
                                                </StackPanel>

                                                <!-- Action Buttons: Live Data (Fresh Emerald Green) & Configure (Refined Slate Navy) -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Live data button: Fresh Emerald Green gradient to contrast with dark configure button -->
                                                    <Button Grid.Column="0" Content="Live data" Height="32"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Style="{StaticResource DashLiveDataBtn}"
                                                            Command="{Binding DataContext.OpenLiveDataCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- Configure button: Refined Slate-Navy button -->
                                                    <Button Grid.Column="2" Content="Configure" Height="32"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Style="{StaticResource ConfigureBtn}"
                                                            Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding DataContext.CanManageDevices, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </Border>
    </ScrollViewer>
</Page>
