<Page x:Class="WTT.UI.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Users">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Users" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Admin: full control · Operator: start/stop capture, view logs · Viewer: read only. New users must change their password at first login." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CoralRefreshBtn}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddCommand}" Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PersonAdd24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add user" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" Style="{StaticResource Grid}" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1" CanUserResizeColumns="True" CanUserReorderColumns="False"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle><DataGrid.Resources><Style TargetType="TextBlock" x:Key="TrimCell"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" MinWidth="32" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Style="{StaticResource Dot}" Margin="0" HorizontalAlignment="Center" Fill="{Binding IsActive, Converter={StaticResource BoolToBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" MinWidth="120" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="180" MinWidth="140" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" MinWidth="80" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="64" MinWidth="60" CanUserResize="False" />
                <DataGridCheckBoxColumn Header="Must change pwd" Binding="{Binding MustChangePassword}" Width="145" MinWidth="135" CanUserResize="False" />
                <DataGridTextColumn Header="Locked until" Binding="{Binding LockoutEndUtc, Converter={StaticResource UtcToLocal}}" Width="140" MinWidth="130" />
                <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginAtUtc, Converter={StaticResource UtcToLocal}}" Width="155" MinWidth="145" FontFamily="Consolas" />
                <DataGridTemplateColumn Header="Actions" Width="150" MinWidth="146" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Modern Blue Gradient Edit Button -->
                                <Button Style="{StaticResource EditBtn}" ToolTip="Edit user" Width="28" Height="28" Margin="0,0,4,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <ui:SymbolIcon Symbol="Edit24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Amber Gradient Reset Password Button -->
                                <Button Style="{StaticResource KeyBtn}" ToolTip="Reset password" Width="28" Height="28" Margin="0,0,4,0" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <ui:SymbolIcon Symbol="Key24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Violet Gradient Unlock Button -->
                                <Button Style="{StaticResource UnlockBtn}" ToolTip="Unlock" Width="28" Height="28" Margin="0,0,4,0" Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <ui:SymbolIcon Symbol="LockOpen24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Industry Grade Trash Button -->
                                <Button Style="{StaticResource TrashBtn}" ToolTip="Delete user" Width="28" Height="28" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <ui:SymbolIcon Symbol="Delete24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
