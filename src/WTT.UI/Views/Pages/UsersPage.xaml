<Page x:Class="WTT.UI.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Users">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Users" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Admin: full control · Operator: start/stop capture, view logs · Viewer: read only. New users must change their password at first login." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Add user" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Primary" Command="{Binding AddCommand}" Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" Style="{StaticResource Grid}" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Style="{StaticResource Dot}" Margin="0" HorizontalAlignment="Center" Fill="{Binding IsActive, Converter={StaticResource BoolToBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150" />
                <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="200" />
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                <DataGridCheckBoxColumn Header="Must change pwd" Binding="{Binding MustChangePassword}" Width="130" />
                <DataGridTextColumn Header="Locked until" Binding="{Binding LockoutEndUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginAtUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                <DataGridTemplateColumn Header="" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Icon="{ui:SymbolIcon Edit24}" ToolTip="Edit" Padding="8,2" Margin="0,0,4,0" Appearance="Secondary" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}" />
                                <ui:Button Icon="{ui:SymbolIcon Key24}" ToolTip="Reset password" Padding="8,2" Margin="0,0,4,0" Appearance="Secondary" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}" />
                                <ui:Button Icon="{ui:SymbolIcon LockOpen24}" ToolTip="Unlock" Padding="8,2" Margin="0,0,4,0" Appearance="Secondary" Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" Padding="8,2" Appearance="Danger" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Page}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
