<Page x:Class="WTT.UI.Views.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Devices">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📟 PLC Devices" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
        <TextBlock Grid.Row="1" Text="Manage connected PLC devices and connections" FontSize="14" Margin="0,0,0,24"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Toolbar and DataGrid -->
        <Border Grid.Row="2" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <ui:Button Content="Add New Device" Icon="Add24" Appearance="Primary" Margin="0,0,12,0" Command="{Binding AddDeviceCommand}"/>
                    <ui:Button Content="Refresh" Icon="ArrowClockwise24" Command="{Binding LoadDevicesCommand}"/>
                </StackPanel>

                <!-- DataGrid -->
                <ui:DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                             HeadersVisibility="Column" SelectionMode="Single">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*"/>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="*"/>
                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="Auto"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="Auto"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.5*"/>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="Auto"/>
                        
                        <!-- Action Buttons Column -->
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:Button Icon="Edit24" Appearance="Secondary" Margin="0,0,4,0"
                                                   Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Icon="Delete24" Appearance="Danger" Margin="4,0,0,0" 
                                                   Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                                   CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
                
                <!-- Loading indicator -->
                <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
