<Page x:Class="WTT.UI.Views.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Devices">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource PageTitle}" />
                <TextBlock Text="PLCs and data loggers. Select a device and open Configure to manage tags, address blocks, triggers and the transfer server." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CoralRefreshBtn}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddCommand}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Add24" Foreground="White" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add device" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ui:TextBox Grid.Row="1" PlaceholderText="Search by name, host or model…" Icon="{ui:SymbolIcon Search24}" Width="360" HorizontalAlignment="Left"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="2" Style="{StaticResource Grid}" ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1"
                  CanUserResizeColumns="True" CanUserReorderColumns="False">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ConfigureCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle><DataGrid.Resources>
                <Style TargetType="TextBlock" x:Key="TrimCell">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" MinWidth="32" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Style="{StaticResource Dot}" HorizontalAlignment="Center" Margin="0" ToolTip="{Binding StatusToolTip}">
                                <Ellipse.Fill>
                                    <MultiBinding Converter="{StaticResource DeviceStatusToBrush}">
                                        <Binding Path="IsRunning" />
                                        <Binding Path="IsConnected" />
                                        <Binding Path="LastError" />
                                    </MultiBinding>
                                </Ellipse.Fill>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Device.Name}" Width="*" MinWidth="130" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Protocol" Binding="{Binding Device.Protocol, Converter={StaticResource EnumDesc}}" Width="92" MinWidth="82" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Device.Manufacturer, Converter={StaticResource EnumDesc}}" Width="108" MinWidth="95" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Model" Binding="{Binding Device.Model, Converter={StaticResource EnumDesc}}" Width="110" MinWidth="95" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Host" Binding="{Binding Device.Host}" Width="102" MinWidth="90" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Port" Binding="{Binding Device.Port}" Width="70" MinWidth="64" />
                <DataGridTextColumn Header="Poll (ms)" Binding="{Binding Device.PollIntervalMs}" Width="76" MinWidth="70" />
                <DataGridTextColumn Header="Mode" Binding="{Binding Device.CaptureMode, Converter={StaticResource EnumDesc}}" Width="78" MinWidth="70" ElementStyle="{StaticResource TrimCell}" />
                <DataGridCheckBoxColumn Header="Capture" Binding="{Binding Device.IsCaptureEnabled}" Width="62" MinWidth="58" CanUserResize="False" />
                <DataGridCheckBoxColumn Header="Monitor" Binding="{Binding Device.IsMonitorEnabled}" Width="62" MinWidth="58" CanUserResize="False" />
                <DataGridTemplateColumn Header="Actions" Width="200" MinWidth="196" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Actions StackPanel: VerticalAlignment=Center so the buttons align exactly in the middle of the DataGrid cell -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Configure button: Dark navy background (#1e3a5f) and white text & icon -->
                                <Button FontSize="12" Margin="0,0,6,0" Padding="8,3" MinWidth="88" Style="{StaticResource ConfigureBtn}"
                                        Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Settings24" Foreground="White" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Configure" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- Modern Blue Gradient Edit Button -->
                                <Button Style="{StaticResource EditBtn}" ToolTip="Edit connection" Margin="0,0,6,0" Width="28" Height="28"
                                           Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon Symbol="Edit24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Industry Grade Trash Button (Zero Bottom Edge Clipping) -->
                                <Button Style="{StaticResource TrashBtn}" ToolTip="Delete" Width="28" Height="28" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon Symbol="Delete24" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
