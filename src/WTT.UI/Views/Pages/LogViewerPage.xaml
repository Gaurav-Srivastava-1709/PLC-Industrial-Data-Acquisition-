<Page x:Class="WTT.UI.Views.Pages.LogViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Logs">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Logs &amp; audit" Style="{StaticResource PageTitle}" />
                <!-- Log file path dikhao taaki user ko pata chale kahan files hain (Manager Req #2) -->
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="Application log files live in " />
                    <Run Text="{Binding LogDirectory, Mode=OneWay}" FontFamily="Consolas" />
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- Level filter: sirf relevant logs dikhao -->
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel}"
                          Width="130" Margin="0,0,8,0" ToolTip="Minimum log level filter" />
                <!-- Text search filter -->
                <ui:TextBox PlaceholderText="Contains…" Width="220"
                            Text="{Binding Contains, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,8,0" ToolTip="Search in message or source" />
                <!-- Auto-Refresh Toggle: TwoWay binding taaki UI switch aur ViewModel state dono sync rahein -->
                <ui:ToggleSwitch IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                                 OnContent="Live (30s)" OffContent="Auto-refresh"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource CoralRefreshBtn}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="Reload log entries from disk">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NeutralBtn}"
                        Command="{Binding OpenFolderCommand}"
                        ToolTip="Open the log folder in Windows Explorer">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Open folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- ===== TAB CONTENT ===== -->
        <TabControl Grid.Row="2" Margin="0,8,0,0">

            <!-- ===== APPLICATION LOG TAB ===== -->
            <TabItem Header="Application log" Style="{StaticResource ProTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Log DataGrid with color-coded levels -->
                    <DataGrid Grid.Row="0"
                              Style="{StaticResource Grid}"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding Selected}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1"
                              CanUserResizeColumns="True" CanUserReorderColumns="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableColumnVirtualization="False">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="TrimCell">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <!-- Timestamp: full precision taaki debugging aasan ho -->
                            <DataGridTextColumn Header="Time"
                                               Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}"
                                               Width="180" MinWidth="170" FontFamily="Consolas" />

                            <!-- Level: color-coded (INF=normal, WRN=orange, ERR/FTL=red) -->
                            <DataGridTemplateColumn Header="Level" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Default: normal text -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="INF">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="DBG">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="WRN">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="FTL">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Source: kaunsi class se log aaya -->
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" MinWidth="150" ElementStyle="{StaticResource TrimCell}" />

                            <!-- Message: single line + ellipsis for performance; tooltip mein full text -->
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{Binding Message}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: koi log nahi mila to user ko batao kyu -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="48"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="No log entries found" HorizontalAlignment="Center"
                                   Margin="0,8,0,4" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12">
                            <Run Text="Check that File Logging is ON in Settings. Log path: " />
                            <Run Text="{Binding LogDirectory, Mode=OneWay}" FontFamily="Consolas" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Status bar -->
                    <TextBlock Grid.Row="1" Margin="4,4,0,0" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Showing " />
                        <Run Text="{Binding Entries.Count, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" entries · Press Ctrl+C to copy selected · " />
                        <Run Text="{Binding LogDirectory, Mode=OneWay}" FontFamily="Consolas" FontSize="10" />
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- ===== AUDIT TRAIL TAB ===== -->
            <TabItem Header="Audit trail" Style="{StaticResource ProTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              Style="{StaticResource Grid}"
                              ItemsSource="{Binding AuditEntries}"
                              Margin="0,8,0,0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1"
                              CanUserResizeColumns="True" CanUserReorderColumns="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableColumnVirtualization="False">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="TrimCell">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time"
                                               Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLocal}}"
                                               Width="155" MinWidth="145" FontFamily="Consolas" />
                            <DataGridTextColumn Header="User"    Binding="{Binding Username}"  Width="100" MinWidth="90" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Action"  Binding="{Binding Action}"    Width="150" MinWidth="130" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Target"  Binding="{Binding Target}"    Width="160" MinWidth="130" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridCheckBoxColumn Header="OK"  Binding="{Binding Success}"   Width="56" MinWidth="52" CanUserResize="False" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}"   Width="*" MinWidth="200" ElementStyle="{StaticResource TrimCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Status bar for Audit -->
                    <TextBlock Grid.Row="1" Margin="4,4,0,0" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Showing " />
                        <Run Text="{Binding AuditEntries.Count, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" recent audit records from database" />
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>

