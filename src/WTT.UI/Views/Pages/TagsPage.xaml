<Page x:Class="WTT.UI.Views.Pages.TagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Tags">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🏷️ PLC Tags Management" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
        <TextBlock Grid.Row="1" Text="Configure sensor tags, memory addresses and monitor live telemetry" FontSize="14" Margin="0,0,0,20"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Main Card -->
        <Border Grid.Row="2" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Select PLC Device:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Add New Tag" Icon="Add24" Appearance="Primary" Margin="0,0,12,0" Command="{Binding AddTagCommand}"/>
                        <ui:Button Content="Refresh" Icon="ArrowClockwise24" Command="{Binding LoadTagsCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <ui:DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                             HeadersVisibility="Column" SelectionMode="Single">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="Tag Name" Binding="{Binding Tag.TagName}" Width="1.2*"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Tag.Address}" Width="*"/>
                        <DataGridTextColumn Header="Data Type" Binding="{Binding Tag.DataType}" Width="Auto"/>
                        
                        <!-- Live Value with Highlight -->
                        <DataGridTemplateColumn Header="Live Value" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1A3498DB" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LiveValue}" FontWeight="Bold" Foreground="#3498DB"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quality Indicator -->
                        <DataGridTemplateColumn Header="Quality" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quality}" FontWeight="SemiBold" Foreground="#2ECC71"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated}" Width="Auto"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Tag.Description}" Width="1.5*"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Tag.IsActive}" Width="Auto"/>
                        
                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:Button Icon="Edit24" Appearance="Secondary" Margin="0,0,4,0"
                                                   Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Icon="Delete24" Appearance="Danger" Margin="4,0,0,0" 
                                                   Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                                   CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
