<Page x:Class="WTT.UI.Views.Pages.AlarmsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:WTT.UI.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:AlarmsViewModel}"
      mc:Ignorable="d" Title="Alarms" d:DesignHeight="768" d:DesignWidth="1024">
    <Page.Resources>
        <Style x:Key="RowBtn" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                    <Setter Property="Foreground" Value="#1A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Professional danger (native Button + own template so WPF-UI hover never turns it white) -->
<Style x:Key="DangerProNative" TargetType="Button"><Setter Property="Background" Value="#B42318"/><Setter Property="BorderBrush" Value="#7A271A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#912018"/><Setter TargetName="Bd" Property="BorderBrush" Value="#5F1D13"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#7A1A12"/><Setter TargetName="Bd" Property="BorderBrush" Value="#4A130D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#E7E5E4"/><Setter TargetName="Bd" Property="BorderBrush" Value="#D6D3D1"/><Setter Property="Foreground" Value="#A8A29E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Alarms &amp; Events" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Monitor active alarms and search historical events (ISA-18.2 compliant)." Style="{StaticResource Hint}" />
            <!-- Retention In-Out + Beep In-Out Bar -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Retention:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="90" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding SelectedRetentionDays}" Margin="0,0,8,0"/>
                    <TextBlock Text="Custom days:" VerticalAlignment="Center" Margin="8,0,4,0" Style="{StaticResource FieldLabel}"/>
                    <ui:TextBox Width="60" Text="{Binding CustomRetentionDays}" Margin="0,0,8,0"/>
                    <ui:Button Content="Save Retention" Appearance="Secondary" Command="{Binding UpdateRetentionCommand}" Margin="0,0,12,0"/>
                    <Button Content="Delete Now" Style="{StaticResource DangerProNative}" Command="{Binding PurgeNowCommand}"/>
                    <CheckBox Content="Beep" IsChecked="{Binding IsBeepEnabled}" VerticalAlignment="Center" ToolTip="Beep ON/Silent for Critical/High"/>
                    <!-- <TextBlock Text="Email Ready (extensible)" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontStyle="Italic"/> -->
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <!-- ACTIVE ALARMS -->
            <TabItem Header="Active Alarms" Padding="12,8">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <ui:Button Content="Acknowledge All" Icon="{ui:SymbolIcon CheckmarkCircle24}" Appearance="Primary" Command="{Binding AcknowledgeAllCommand}" />
                        <Button Style="{StaticResource CoralRefreshBtn}" Command="{Binding LoadActiveAlarmsCommand}" Margin="12,0,0,0" ToolTip="Refresh alarms">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource Grid}" ItemsSource="{Binding ActiveAlarms}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1"
                              CanUserResizeColumns="True" CanUserReorderColumns="False">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="TrimCell">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="84" MinWidth="78" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95" MinWidth="88" />
                            <DataGridTextColumn Header="Triggered (UTC)" Binding="{Binding TriggeredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155" MinWidth="145" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="140" MinWidth="120" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="150" MinWidth="130" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding AlarmType}" Width="70" MinWidth="64" />
                            <DataGridTextColumn Header="Value" Binding="{Binding TriggerValue}" Width="68" MinWidth="62" />
                            <DataGridTextColumn Header="Limit" Binding="{Binding ThresholdValue}" Width="68" MinWidth="62" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTemplateColumn Header="Actions" Width="110" MinWidth="106" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource RowBtn}">
                                                    <Setter Property="Content" Value="Acknowledge" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Acknowledged">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Content" Value="Acknowledged" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ALARM HISTORY -->
            <TabItem Header="Alarm History" Padding="12,8">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Search Filters" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Device name" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Text="{Binding FilterDeviceName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                                    <TextBlock Text="Tag name" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Text="{Binding FilterTagName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8">
                                    <TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding FilterPriority}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                                    <TextBlock Text="State" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding FilterState}" />
                                </StackPanel>

                                <!-- Date pickers would go here, omitting for simplicity/space. Standard textboxes for now -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <ui:Button Content="Clear" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="Search" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Command="{Binding LoadHistoryCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1" Style="{StaticResource Grid}" ItemsSource="{Binding HistoryAlarms}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1"
                              CanUserResizeColumns="True" CanUserReorderColumns="False">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="TrimCell">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Triggered (UTC)" Binding="{Binding TriggeredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155" MinWidth="145" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Cleared (UTC)" Binding="{Binding ClearedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155" MinWidth="145" FontFamily="Consolas" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95" MinWidth="88" />
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="84" MinWidth="78" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="130" MinWidth="115" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="140" MinWidth="120" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Val" Binding="{Binding TriggerValue}" Width="64" MinWidth="58" />
                            <DataGridTextColumn Header="Limit" Binding="{Binding ThresholdValue}" Width="64" MinWidth="58" />
                            <DataGridTextColumn Header="Ack By" Binding="{Binding AcknowledgedBy}" Width="130" MinWidth="110" ElementStyle="{StaticResource TrimCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding PrevPageCommand}" />
                        <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="12,0" />
                        <TextBlock Text="of" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
