<Page x:Class="WTT.UI.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="My Profile" ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel Margin="24,16,24,48" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="My Profile" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Your account on this machine — details, access and security." Style="{StaticResource PageSubtitle}" />

            <!-- Identity header -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="999" Margin="0,0,16,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="PersonCircle24" FontSize="32" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Border CornerRadius="999" Padding="10,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding RoleName, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <Border CornerRadius="999" Padding="10,2" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="@" /><Run Text="{Binding Username, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ui:InfoBar IsOpen="{Binding MustChangePassword}" Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                        Title="Password change required" Message="Your account is flagged to change password. Use the Change password button below." />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Account details -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Account details" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Username (login)" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding RoleName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Member since" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding CreatedAtUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}}" FontSize="13" />
                        <TextBlock Text="Last login" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding LastLoginAtUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}, TargetNullValue=Never logged in}" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Status + security -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Status &amp; security" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding IsActive, Converter={StaticResource BoolToBrush}}" />
                            <TextBlock Text="Active" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Inactive" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="Only active accounts can sign in." Style="{StaticResource Hint}" Margin="18,2,0,0" />
                        <TextBlock Text="Locked out until" Style="{StaticResource FieldLabel}"
                                   Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding LockoutEndUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}}"
                                   FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVis}}" />
                        <Border Height="1" Margin="0,14,0,0"
                                Background="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.16" />
                        <Button Style="{StaticResource NeutralBtn}"
                                   Command="{Binding ChangePasswordCommand}" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Key24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Change password" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NeutralBtn}"
                                   Command="{Binding LogoutCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="SignOut24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sign out" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Signing out returns to the login screen. Capture keeps running in the background service."
                                   Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- What I can do -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="What I can do" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Pages and actions allowed for your role." Style="{StaticResource Hint}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding MyPermissions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="999" Padding="10,4" Margin="0,0,8,8" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
