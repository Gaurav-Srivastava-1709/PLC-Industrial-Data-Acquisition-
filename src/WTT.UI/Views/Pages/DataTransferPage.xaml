<Page x:Class="WTT.UI.Views.Pages.DataTransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Data Transfer">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="🔄 Data Transfer Engine" FontSize="28" FontWeight="SemiBold" 
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Bulk synchronization of local Tag Readings to Central SQL Server" FontSize="14" Margin="0,4,0,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Service Status: " VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <Border Padding="12,6" CornerRadius="4" Margin="8,0,16,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#33FF5252"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#334CAF50"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Stopped"/>
                                <Setter Property="Foreground" Value="#FF5252"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Text" Value="Running"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                
                <ui:Button Appearance="Primary" Command="{Binding ToggleServiceCommand}" Width="120">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Start Service"/>
                            <Setter Property="Icon" Value="Play24"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Stop Service"/>
                                    <Setter Property="Icon" Value="Stop24"/>
                                    <Setter Property="Appearance" Value="Danger"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                    CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Pending Transfer" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding PendingRecordsCount}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="#FFC107"/>
                    <TextBlock Text="Records in local SQLite" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                    CornerRadius="8" Padding="16" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="Session Transferred" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalTransferredCount}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="#4CAF50"/>
                    <TextBlock Text="Records bulk copied today" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                    CornerRadius="8" Padding="16" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="Transfer Errors" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding TransferErrorsCount}" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="#FF5252"/>
                    <TextBlock Text="Circuit breaker blocked" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                    CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Last Sync" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding LastSuccessfulTransferAt}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="SQL Server Ack" FontSize="11" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progress Section -->
        <Border Grid.Row="2" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="20" Margin="0,0,0,24">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Live Activity" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding ProgressMessage}" HorizontalAlignment="Right" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                
                <!-- Fluent Progress Bar -->
                <ProgressBar Value="{Binding CurrentProgressPercent}" Maximum="100" Height="8" 
                             Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                             Background="{ui:ThemeResource ControlFillColorDefaultBrush}"/>

                <!-- Polly Error Alert -->
                <ui:InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Network Failure Detected" 
                            Message="{Binding LastErrorMessage}" Margin="0,16,0,0" IsClosable="False"/>

                <!-- Manual Trigger -->
                <ui:Button Content="Transfer Pending Records Now" Icon="ArrowUpload24" Appearance="Secondary" 
                           Command="{Binding TransferNowCommand}" Margin="0,16,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
