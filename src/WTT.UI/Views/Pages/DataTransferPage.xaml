<Page x:Class="WTT.UI.Views.Pages.DataTransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Data transfer">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Data transfer" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Store-and-forward from the local buffer to each device's central SQL Server. Transfers are idempotent and retried automatically." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Transfer all now" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding TransferNowCommand}"
                           Visibility="{Binding CanControl, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Pending, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" /><TextBlock Text="Waiting in local buffer" Style="{StaticResource StatLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding TransferredToday, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" /><TextBlock Text="Transferred today" Style="{StaticResource StatLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding FailedToday, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" /><TextBlock Text="Failed batches today" Style="{StaticResource StatLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding LastSuccessUtc, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss}" Style="{StaticResource StatValue}" FontSize="22" /><TextBlock Text="Last successful transfer" Style="{StaticResource StatLabel}" /></StackPanel></Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding CanControl, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Transfer pipeline" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
            <ui:ToggleSwitch IsChecked="{Binding IsPaused, Mode=OneWay}" OnContent="Paused" OffContent="Running" Command="{Binding TogglePauseCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="3" Style="{StaticResource Grid}" ItemsSource="{Binding Servers}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Style="{StaticResource Dot}" Margin="0" HorizontalAlignment="Center" Fill="{Binding IsEnabled, Converter={StaticResource BoolToBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Device" Binding="{Binding Device.Name}" Width="160" />
                <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="180" />
                <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130" />
                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="110" />
                <DataGridTextColumn Header="Auth" Binding="{Binding UserId}" Width="110" />
                <DataGridTextColumn Header="Last success" Binding="{Binding LastSuccessAtUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="*" />
                <DataGridTemplateColumn Header="" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Transfer now" Padding="8,2" Margin="0,0,4,0" Appearance="Secondary" Command="{Binding DataContext.TransferNowCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Content="Enable/disable" Padding="8,2" Margin="0,0,4,0" Appearance="Secondary" Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Icon="{ui:SymbolIcon Settings24}" Padding="8,2" Appearance="Secondary" Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Recent batches" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
        <DataGrid Grid.Row="5" Style="{StaticResource Grid}" ItemsSource="{Binding Batches}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding StartedAtUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="150" />
                <DataGridTextColumn Header="Target" Binding="{Binding TargetServer}" Width="160" />
                <DataGridTextColumn Header="Rows" Binding="{Binding RecordCount, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="70" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
