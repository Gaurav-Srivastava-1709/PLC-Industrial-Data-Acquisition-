<Page x:Class="WTT.UI.Views.Pages.DataTransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Data transfer">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Data transfer" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Store-and-forward from the local buffer to each device's central SQL Server. Transfers are idempotent and retried automatically." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CoralRefreshBtn}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <!-- Waiting (amber) -->
            <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiAmberBg}" ToolTip="Readings waiting in local buffer">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#D97706" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Database24" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WAITING IN LOCAL BUFFER" Style="{StaticResource KpiLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Pending, StringFormat={}{0:N0}}" Style="{StaticResource KpiValue}" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10" Background="#D97706" Margin="-14,12,-14,0" />
                </Grid>
            </Border>
            <!-- Transferred (teal) -->
            <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiTealBg}" ToolTip="Rows transferred today">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#0D9488" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TRANSFERRED TODAY" Style="{StaticResource KpiLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TransferredToday, StringFormat={}{0:N0}}" Style="{StaticResource KpiValue}" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10" Background="#0D9488" Margin="-14,12,-14,0" />
                </Grid>
            </Border>
            <!-- Failed (red) -->
            <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiRedBg}" ToolTip="Failed batches today">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#DC2626" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="AlertUrgent24" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FAILED BATCHES TODAY" Style="{StaticResource KpiLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FailedToday, StringFormat={}{0:N0}}" Style="{StaticResource KpiValue}" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10" Background="#DC2626" Margin="-14,12,-14,0" />
                </Grid>
            </Border>
            <!-- Last success (blue) -->
            <Border Style="{StaticResource ModernKpiCard}" Background="{StaticResource KpiBlueBg}" ToolTip="Last successful transfer">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#2563EB" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DataHistogram24" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LAST SUCCESSFUL TRANSFER" Style="{StaticResource KpiLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="34" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding LastSuccessUtc, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss}" Style="{StaticResource KpiValue}" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Height="5" CornerRadius="0,0,10,10" Background="#2563EB" Margin="-14,12,-14,0" />
                </Grid>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Automatic transfer is owned by the WTT Windows Service." VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
            <ProgressBar IsIndeterminate="True" Width="180" Height="6" Margin="16,0,0,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <DataGrid Grid.Row="3" Style="{StaticResource Grid}" ItemsSource="{Binding Servers}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1" CanUserResizeColumns="True" CanUserReorderColumns="False"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle><DataGrid.Resources><Style TargetType="TextBlock" x:Key="TrimCell"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" MinWidth="32" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Style="{StaticResource Dot}" Margin="0" HorizontalAlignment="Center" Fill="{Binding IsEnabled, Converter={StaticResource BoolToBrush}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Device" Binding="{Binding Device.Name}" Width="150" MinWidth="130" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="130" MinWidth="100" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="140" MinWidth="120" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="100" MinWidth="90" />
                <DataGridTextColumn Header="Auth" Binding="{Binding UserId}" Width="80" MinWidth="70" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Last success" Binding="{Binding LastSuccessAtUtc, Converter={StaticResource UtcToLocal}}" Width="155" MinWidth="145" FontFamily="Consolas" />
                <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="*" MinWidth="180" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTemplateColumn Header="Actions" Width="170" MinWidth="166" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Enable/disable" FontSize="12" Padding="6,3" Margin="0,0,4,0" Appearance="Secondary" Style="{StaticResource RowActionBtn}" Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Icon="{ui:SymbolIcon Settings24}" Padding="6,3" Appearance="Secondary" Style="{StaticResource RowActionBtn}" Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Recent batches" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
        <DataGrid Grid.Row="5" Style="{StaticResource Grid}" ItemsSource="{Binding Batches}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FrozenColumnCount="1" CanUserResizeColumns="True" CanUserReorderColumns="False"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger></Style.Triggers></Style></DataGrid.CellStyle><DataGrid.Resources><Style TargetType="TextBlock" x:Key="TrimCell"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding StartedAtUtc, Converter={StaticResource UtcToLocal}}" Width="175" MinWidth="165" FontFamily="Consolas" />
                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="140" MinWidth="120" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Target" Binding="{Binding TargetServer}" Width="90" MinWidth="80" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Rows" Binding="{Binding RecordCount, StringFormat={}{0:N0}}" Width="80" MinWidth="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" MinWidth="75" />
                <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="70" MinWidth="60" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
