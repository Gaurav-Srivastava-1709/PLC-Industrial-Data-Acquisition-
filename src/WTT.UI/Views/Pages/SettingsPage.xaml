<Page x:Class="WTT.UI.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings" ScrollViewer.CanContentScroll="False">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False">
        <StackPanel Margin="24,16,24,48" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Runtime settings are stored in the local database and apply immediately — no restart needed." Style="{StaticResource PageSubtitle}" />

            <!-- My Account — moved here from the top bar so the header stays clean.
                 Visible to every role (Viewer/Operator/Admin). -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="999" Margin="0,0,14,0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="PersonCircle24" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="My Account" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                            <Run Text="  ·  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding RoleName, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="Signed in on this machine. Change your own password or sign out here."
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Change password" Icon="{ui:SymbolIcon Key24}" Appearance="Secondary"
                                   Command="{Binding ChangePasswordCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Sign out" Icon="{ui:SymbolIcon SignOut24}" Appearance="Secondary"
                                   Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <ui:ToggleSwitch IsChecked="{Binding IsDarkMode}" OnContent="Dark theme" OffContent="Light theme" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Simulation" Style="{StaticResource SectionTitle}" />
                    <ui:ToggleSwitch IsChecked="{Binding UseMockPlc}" OnContent="PLC simulator ON — all devices return simulated values" OffContent="PLC simulator OFF — real controllers" />
                    <ui:InfoBar IsOpen="{Binding UseMockPlc}" Severity="Warning" IsClosable="False" Margin="0,8,0,0"
                                Title="Simulator active" Message="Every device is served by the built-in simulator. Values in the historian are fake while this is on." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Security &amp; retention" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Session timeout (minutes)" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox Value="{Binding SessionTimeoutMinutes}" Minimum="1" Maximum="720" SpinButtonPlacementMode="Inline" />
                            <TextBlock Style="{StaticResource Hint}" Text="Idle users are signed out automatically." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Keep transferred readings (days)" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox Value="{Binding TransferredRetentionDays}" Minimum="1" Maximum="3650" SpinButtonPlacementMode="Inline" />
                            <TextBlock Style="{StaticResource Hint}" Text="Readings already on the central server are deleted locally after this many days. Untransferred readings are never deleted." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Transfer interval (seconds)" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox Value="{Binding TransferIntervalSeconds}" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Inline" />
                            <TextBlock Style="{StaticResource Hint}" Text="How often the buffer is shipped to the central servers." />
                        </StackPanel>
                    </Grid>
                    <ui:Button Content="Save settings" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Margin="0,16,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Local database" Style="{StaticResource SectionTitle}" />
                    <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding DatabaseLocation}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}"><Run Text="Edition: " /><Run Text="{Binding DatabaseEdition, Mode=OneWay}" /><Run Text=" · Size: " /><Run Text="{Binding DatabaseSize, Mode=OneWay}" /></TextBlock>
                    <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,10,0,0"
                                Title="Managed by SQL Server" Message="Local data uses Windows Integrated Security. Backups and database files are managed by SQL Server, not by the WTT user interface." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock><Run Text="WTT Industrial Data Acquisition · version " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Hint}" Text=".NET 10 LTS · WPF (WPF-UI) · EF Core + SQL Server Express · Serilog · libplctag · S7.Net · NModbus · Polly · BCrypt." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
