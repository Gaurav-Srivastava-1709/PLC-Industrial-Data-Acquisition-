<Page x:Class="WTT.UI.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:WTT.UI.Views.Windows"
      Title="Settings">
    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="⚙️ Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Application configuration and preferences" FontSize="14" Margin="0,0,0,24"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Appearance Settings -->
            <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎨 Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Dark Mode" FontWeight="Medium" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Toggle between Dark and Light theme" FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode, Mode=TwoWay}"/>
                    </Grid>
                    
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Mock PLC Mode" FontWeight="Medium" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Generate fake data instead of connecting to real hardware" FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMockPlcEnabled, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SQL Server & Data Transfer Config -->
            <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔄 Central Data Sync" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Transfer Service Enable" FontWeight="Medium" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Automatically sync data to Central SQL Server" FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsTransferEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <TextBlock Text="Central Server Details" FontWeight="SemiBold" Margin="0,12,0,8" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server Name / IP:" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding SqlServerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. (localdb)\MSSQLLocalDB"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Database Name:" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding SqlDatabaseName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. WTT_Central"/>
                    </Grid>

                    <CheckBox IsChecked="{Binding SqlUseWindowsAuth}" Content="Use Windows Authentication (Integrated Security)" Margin="0,0,0,12"/>

                    <StackPanel Visibility="{Binding SqlUseWindowsAuth, Converter={StaticResource InverseBooleanConverter}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="User ID:" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox Grid.Column="1" Text="{Binding SqlUserId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. sa"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Password:" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ui:PasswordBox Grid.Column="1" Password="{Binding SqlPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ConnectionTestResult}" VerticalAlignment="Center" 
                                   Foreground="{Binding TestResultColor}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="1" Content="Test Connection" Command="{Binding TestConnectionCommand}" 
                                   Appearance="Secondary" Margin="0,0,8,0" Icon="PlugConnected24"/>
                        <ui:Button Grid.Column="2" Content="Save Config" Command="{Binding SaveSqlConfigCommand}" 
                                   Appearance="Primary" Icon="Save24"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <TextBlock Text="ℹ️ About" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="WTT Systems — Modern Industrial DAQ Platform" FontWeight="Medium"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Version: 1.0.0 (Phase 2)" FontSize="13" Margin="0,4,0,0"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Built with: .NET 9 | WPF-UI | SQLite | Clean Architecture" FontSize="13" Margin="0,4,0,0"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
