<ui:FluentWindow x:Class="WTT.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WTT - Login" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WTT Systems" />

        <StackPanel Grid.Row="1" Margin="40,20,40,40" VerticalAlignment="Center">
            <!-- Icon -->
            <ui:SymbolIcon Symbol="ShieldLock24" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
            
            <TextBlock Text="Welcome Back" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Please sign in to continue" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Error Message (Uses HasError via DataTrigger for visibility) -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5757" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Username" Margin="0,0,0,5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter username" Margin="0,0,0,15" Icon="Person24" />

            <TextBlock Text="Password" Margin="0,0,0,5" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <ui:PasswordBox x:Name="txtPassword" PlaceholderText="Enter password" Margin="0,0,0,25" Icon="Password24" PasswordChanged="txtPassword_PasswordChanged" />

            <ui:Button Content="Sign In" Command="{Binding LoginCommand}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
            
            <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,15,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
