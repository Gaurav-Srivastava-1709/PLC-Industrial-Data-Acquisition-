{
  "Database": {
    "ConnectionString": "Server=.;Database=WTT;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=WTT;Connect Timeout=10;Pooling=True"
  },
  "Capture": {
    "ReconcileIntervalSeconds": 5,
    "MinPollIntervalMs": 100,
    "ReconnectInitialDelaySeconds": 2,
    "ReconnectMaxDelaySeconds": 60,
    "CurrentValueFlushSeconds": 5,
    "TransferredRetentionDays": 7,
    "UntransferredMaxAgeDays": 0
  },
  "Transfer": {
    "IntervalSeconds": 5,
    "BatchSize": 1000,
    "BulkCopyBatchSize": 1000,
    "BulkCopyTimeoutSeconds": 60,
    "CommandTimeoutSeconds": 30,
    "RetryCount": 3,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 60,
    "MaxBatchesPerDevicePerCycle": 4
  },
  "Security": {
    "SessionTimeoutMinutes": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 8,
    "RequireMixedCasePassword": true,
    "RequireDigitPassword": true,
    "BcryptWorkFactor": 12
  },
  "Simulation": {
    "UseMockPlc": false
  },
  "Logging": {
    "EnableFileLogging": true,
    "LogDirectory": "%LocalAppData%/WTT/Logs",
    "FileName": "wtt",
    "RollingInterval": "Day",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 20971520,
    "RollOnFileSizeLimit": true,
    "FlushToDiskInterval": "00:00:02",
    "MinimumLevel": "Information",
    "LevelOverrides": {
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "UseJsonFormatter": false,
    "IncludeScopingProperties": true,
    "EnablePiiMasking": true,
    "AdditionalSinks": [],
    "EnableDebugSink": true
  }
}
